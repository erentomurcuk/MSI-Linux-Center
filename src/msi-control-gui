class NavStack(QStackedWidget):
    """A QStackedWidget that remembers tab labels.

    The sections are driven from the sidebar now, but keeping the small
    QTabWidget-shaped surface (addTab / count / currentIndex / tabText) means
    the smoke test and the settings-persistence code did not have to care
    which widget is actually doing the switching.
    """

    def __init__(self, parent=None):
        super().__init__(parent)
        self._labels: list = []

    def addTab(self, widget: QWidget, label: str):
        self._labels.append(label)
        self.addWidget(widget)

    def tabText(self, index: int) -> str:
        return self._labels[index]


