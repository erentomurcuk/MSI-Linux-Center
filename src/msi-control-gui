# --------------------------------------------------------------------------
# painted glyphs — a handful of vector icons, so the UI has a visual language
# without shipping (and licensing) an icon theme.
# --------------------------------------------------------------------------

def glyph_pixmap(name: str, size: int = 20, color: str = "#ffffff") -> QPixmap:
    """Draw one small monochrome icon.  Normalised 0..1 coordinates, so every
    glyph scales from the 16 px sidebar to the 32 px header mark."""
    pm = QPixmap(size, size)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    s = float(size)
    pad = s * 0.16
    w = s - 2 * pad
    c = QColor(color)
    pen = QPen(c)
    pen.setWidthF(max(1.4, s * 0.085))
    pen.setCapStyle(Qt.RoundCap)
    pen.setJoinStyle(Qt.RoundJoin)
    p.setPen(pen)
    p.setBrush(Qt.NoBrush)

    def R(x, y, ww, hh) -> QRectF:
        return QRectF(pad + x * w, pad + y * w, ww * w, hh * w)

    if name == "dashboard":
        for x, y in ((0, 0), (0.56, 0), (0, 0.56), (0.56, 0.56)):
            p.drawRoundedRect(R(x, y, 0.44, 0.44), 0.1 * w, 0.1 * w)
    elif name == "fans":                              # hub + three blades
        cx, cy = pad + 0.5 * w, pad + 0.5 * w
        p.translate(cx, cy)
        for k in range(3):
            p.save()
            p.rotate(k * 120)
            p.drawEllipse(QRectF(-0.13 * w, -0.5 * w, 0.26 * w, 0.46 * w))
            p.restore()
        p.drawEllipse(QPointF(0, 0), 0.13 * w, 0.13 * w)
    elif name == "battery":
        p.drawRoundedRect(R(0, 0.24, 0.78, 0.52), 0.12 * w, 0.12 * w)
        p.setBrush(c)
        p.drawRoundedRect(R(0.83, 0.4, 0.13, 0.2), 0.05 * w, 0.05 * w)
        p.drawRoundedRect(R(0.1, 0.34, 0.42, 0.32), 0.06 * w, 0.06 * w)
    elif name == "profiles":                          # bookmark
        path = QPainterPath()
        path.moveTo(pad + 0.22 * w, pad)
        path.lineTo(pad + 0.78 * w, pad)
        path.lineTo(pad + 0.78 * w, pad + w)
        path.lineTo(pad + 0.5 * w, pad + 0.72 * w)
        path.lineTo(pad + 0.22 * w, pad + w)
        path.closeSubpath()
        p.drawPath(path)
    elif name == "settings":                          # three sliders
        for y, k in ((0.22, 0.66), (0.5, 0.32), (0.78, 0.58)):
            p.drawLine(QPointF(pad, pad + y * w), QPointF(pad + w, pad + y * w))
            p.setBrush(c)
            p.drawEllipse(QPointF(pad + k * w, pad + y * w), 0.11 * w, 0.11 * w)
            p.setBrush(Qt.NoBrush)
    elif name == "refresh":
        p.drawArc(R(0.06, 0.06, 0.88, 0.88), 60 * 16, 250 * 16)
        p.setBrush(c)
        tip = QPainterPath()
        tip.moveTo(pad + 0.94 * w, pad + 0.36 * w)
        tip.lineTo(pad + 0.60 * w, pad + 0.42 * w)
        tip.lineTo(pad + 0.92 * w, pad + 0.70 * w)
        tip.closeSubpath()
        p.drawPath(tip)
    elif name == "power":
        p.drawArc(R(0.08, 0.12, 0.84, 0.84), 55 * 16, 250 * 16)
        p.drawLine(QPointF(pad + 0.5 * w, pad), QPointF(pad + 0.5 * w,
                                                       pad + 0.52 * w))
    elif name == "bolt":                              # Performance
        path = QPainterPath()
        pts = [(0.58, 0.0), (0.16, 0.56), (0.44, 0.56), (0.36, 1.0),
               (0.84, 0.42), (0.54, 0.42)]
        path.moveTo(pad + pts[0][0] * w, pad + pts[0][1] * w)
        for x, y in pts[1:]:
            path.lineTo(pad + x * w, pad + y * w)
        path.closeSubpath()
        p.setBrush(c)
        p.drawPath(path)
    elif name == "warn":
        path = QPainterPath()
        path.moveTo(pad + 0.5 * w, pad)
        path.lineTo(pad + w, pad + w)
        path.lineTo(pad, pad + w)
        path.closeSubpath()
        p.drawPath(path)
        p.drawLine(QPointF(pad + 0.5 * w, pad + 0.34 * w),
                   QPointF(pad + 0.5 * w, pad + 0.62 * w))
        p.setBrush(c)
        p.drawEllipse(QPointF(pad + 0.5 * w, pad + 0.82 * w), 0.06 * w,
                      0.06 * w)
    p.end()
    return pm


def nav_icon(name: str, size: int = ICON_SM) -> QIcon:
    """A nav glyph that lights up in the accent colour when selected.

    QPushButton draws its icon in the QIcon.On state when checked, so the
    two pixmaps give the selected row both a tinted background *and* a
    brightened icon — a colour change on its own is easy to miss."""
    ic = QIcon()
    ic.addPixmap(glyph_pixmap(name, size, THEME["text_dim"]),
                 QIcon.Mode.Normal, QIcon.State.Off)
    ic.addPixmap(glyph_pixmap(name, size, THEME["accent"]),
                 QIcon.Mode.Normal, QIcon.State.On)
    ic.addPixmap(glyph_pixmap(name, size, THEME["text"]),
                 QIcon.Mode.Active, QIcon.State.Off)
    ic.addPixmap(glyph_pixmap(name, size, THEME["accent_hover"]),
                 QIcon.Mode.Active, QIcon.State.On)
    return ic


def shield_path(rect: QRectF) -> QPainterPath:
    """The MSI-style heraldic shield: square shoulders, curving to a point.

    One description shared by the painted app mark, the tray fallback and
    (as hand-written path data) `icons/msi-control.svg`, so the mark in the
    window and the icon in the menu cannot look like two different apps.
    Control points are the SVG's, normalised to the box.
    """
    x, y, w, h = rect.left(), rect.top(), rect.width(), rect.height()
    path = QPainterPath()
    path.moveTo(x, y)
    path.lineTo(x + w, y)
    path.lineTo(x + w, y + h * 0.389)
    path.cubicTo(x + w, y + h * 0.70,
                 x + w * 0.744, y + h * 0.878,
                 x + w * 0.5, y + h)
    path.cubicTo(x + w * 0.256, y + h * 0.878,
                 x, y + h * 0.70,
                 x, y + h * 0.389)
    path.closeSubpath()
    return path


# Where the shield sits on the mark's square, as x, y, width, height
# fractions.  Sized so the shape fills the canvas with an even margin — the
# mark *is* the shield, so whatever is left over is wasted — and centred, so
# it sits level with its neighbours in a taskbar.  The same four numbers are
# baked into `icons/msi-control.svg`; `check_brand_mark` rasterises both and
# compares the outlines, so the two cannot drift apart.
MARK_BOX = (19.0 / 128, 12.0 / 128, 90.0 / 128, 104.0 / 128)

# The shield's three gradient stops — the same three the SVG carries, in the
# same order and at the same positions.
BRAND_RED = ("#ff4a3d", "#e2231a", "#9c0a19")


def _mark_frame(size: int):
    """A transparent canvas with the shield's bounding box on it.

    An earlier version of this mark was a dark rounded tile carrying the
    shield *and* the model number.  At the 16-22 px a taskbar and a menu
    actually render it, that was a dark square with an unreadable smudge in
    it, so both the tile and the lettering are gone: one shape, drawn as
    large as it will go.  Returning the box keeps `brand_pixmap` and
    `temp_pixmap` geometrically identical by construction rather than by
    copy-paste.
    """
    pm = QPixmap(size, size)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    s = float(size)
    x, y, w, h = MARK_BOX
    return pm, p, QRectF(s * x, s * y, s * w, s * h)


def _mark_shield(p: QPainter, box: QRectF, stops) -> None:
    """The shield itself.  `stops` are the three gradient colours, in order —
    `brand_pixmap` passes the same three the SVG carries, so the painted mark
    and the installed icon cannot drift into different reds."""
    shield = shield_path(box)
    grad = QLinearGradient(box.left(), box.top(),
                           box.left() + box.width() * 0.25, box.bottom())
    for pos, col in zip((0.0, 0.5, 1.0), stops):
        grad.setColorAt(pos, col)
    p.setPen(Qt.NoPen)
    p.setBrush(QBrush(grad))
    p.drawPath(shield)


def brand_pixmap(size: int = 32) -> QPixmap:
    """The app mark: an MSI-red shield bearing Tux, and nothing else.

    Matching `icons/msi-control.svg` shape for shape.  Painted rather than
    loaded so the GUI keeps its no-icon-theme dependency, and so the window
    icon, the header mark and the tray all agree without shipping a second
    file.
    """
    pm, p, box = _mark_frame(size)
    _mark_shield(p, box, BRAND_RED)
    _mark_tux(p, box)
    p.end()
    return pm


# Tux's own colours, kept here so the painted mark and the SVG use the same
# three.  Not the theme's: the penguin is the mascot, not a UI element, and a
# white-bellied black penguin is what makes it recognisable at 16 px.
TUX_BLACK = "#1c1c1c"
TUX_WHITE = "#f8f6f0"
TUX_ORANGE = "#f6a21d"


def _mark_tux(p: QPainter, box: QRectF) -> None:
    """Tux, sitting inside the shield.

    One description, shared with `icons/msi-control.svg`, painted from a unit
    box so the proportions are the mascot's rather than a generic bird's: a
    round black body, a white belly, a white face with two eyes, an orange
    beak and two orange feet.  Placed a little high in the box because the
    shield tapers to a point, and sized to leave the shield's red as a clear
    field around the silhouette.
    """
    w = box.width() * 0.62
    h = box.height() * 0.66
    cx = box.center().x()
    top = box.top() + box.height() * 0.17
    left = cx - w / 2

    def P(u: float, v: float) -> QPointF:
        """Unit-box (0..1, 0..1) -> a point in the mark."""
        return QPointF(left + u * w, top + v * h)

    def R(u: float, v: float, rw: float, rh: float) -> QRectF:
        return QRectF(left + u * w, top + v * h, rw * w, rh * h)

    def curve(start, segs):
        path = QPainterPath(P(*start))
        for c1, c2, end in segs:
            path.cubicTo(P(*c1), P(*c2), P(*end))
        path.closeSubpath()
        return path

    # Body: narrow head, wide hips, a slight flipper bulge at the shoulders.
    body = curve(
        (0.50, 0.00),
        [((0.62, 0.00), (0.70, 0.09), (0.72, 0.21)),
         ((0.74, 0.32), (0.83, 0.30), (0.90, 0.45)),
         ((0.99, 0.62), (0.96, 0.85), (0.78, 0.95)),
         ((0.66, 1.01), (0.34, 1.01), (0.22, 0.95)),
         ((0.04, 0.85), (0.01, 0.62), (0.10, 0.45)),
         ((0.17, 0.30), (0.26, 0.32), (0.28, 0.21)),
         ((0.30, 0.09), (0.38, 0.00), (0.50, 0.00))])
    p.setPen(Qt.NoPen)
    p.setBrush(QColor(TUX_BLACK))
    p.drawPath(body)

    # Feet, poking out below the body.
    p.setBrush(QColor(TUX_ORANGE))
    p.drawEllipse(R(0.20, 0.88, 0.28, 0.14))
    p.drawEllipse(R(0.52, 0.88, 0.28, 0.14))

    # Belly.
    p.setBrush(QColor(TUX_WHITE))
    p.drawEllipse(R(0.22, 0.46, 0.56, 0.48))

    # Face: the white patch the eyes and beak sit on.
    face = curve(
        (0.50, 0.10),
        [((0.66, 0.10), (0.72, 0.22), (0.70, 0.33)),
         ((0.67, 0.44), (0.60, 0.48), (0.50, 0.48)),
         ((0.40, 0.48), (0.33, 0.44), (0.30, 0.33)),
         ((0.28, 0.22), (0.34, 0.10), (0.50, 0.10))])
    p.drawPath(face)

    # Eyes.
    p.setBrush(QColor(TUX_BLACK))
    p.drawEllipse(R(0.35, 0.20, 0.10, 0.10))
    p.drawEllipse(R(0.55, 0.20, 0.10, 0.10))

    # Beak.
    p.setBrush(QColor(TUX_ORANGE))
    beak = QPainterPath(P(0.42, 0.32))
    beak.lineTo(P(0.58, 0.32))
    beak.lineTo(P(0.50, 0.45))
    beak.closeSubpath()
    p.drawPath(beak)


def tray_digit_font(size: int, label: str) -> QFont:
    """The font for the tray's temperature reading.

    Sized off the *label*, not just the icon: “100” at the two-digit size
    runs over the shield's edges, and a tray icon has no room to be clipped.
    Its own function so the smoke test can measure the fit at the sizes the
    tray really paints, instead of hunting for the digits in a raster.
    """
    f = QFont()
    f.setPixelSize(max(7, int(size * (0.42 if len(label) <= 2 else 0.33))))
    f.setBold(True)
    return f


def temp_pixmap(size: int, temp, label: str = "") -> QPixmap:
    """The app mark tinted by the hottest reading — the tray icon.

    Same shield as `brand_pixmap` so the tray, the window and the menu entry
    are recognisably one app; the *fill* is the temperature band, so the tray
    also answers “how hot is it” without opening the window.  A grey shield
    means no reading has arrived yet.

    The reading is the one thing painted on the shield, and the only place
    the mark carries text at all: a tray icon has no label beside it.
    """
    pm, p, box = _mark_frame(size)
    col = QColor(temp_color(temp))
    _mark_shield(p, box, (col.lighter(118), col, col.darker(135)))
    if label:
        p.setPen(QPen(QColor(text_on(col.name()))))
        p.setFont(tray_digit_font(size, label))
        p.drawText(box, Qt.AlignCenter, label)
    p.end()
    return pm


def hint_label(text: str, parent=None) -> QLabel:
    """The one helper for explanatory small print — themed, wrapping, muted."""
    h = QLabel(text, parent)
    h.setWordWrap(True)
    h.setFont(ui_font(TYPE_BODY))
    h.setStyleSheet(f"color:{muted_color(h)}")
    return h


def notice_style(colour: str, background: str | None = None) -> str:
    """Inline QSS for a warning / status strip inside a page.

    One helper so the fan-curve and MUX warnings — which are both "here is
    why this control is not going to work" — cannot end up with different
    padding, radius or text colour, as they did.
    """
    if background:
        return (f"color:{text_on(background)};background:{background};"
                f"padding:8px 11px;border-radius:{R_CTRL}px;"
                "font-weight:bold;")
    return f"color:{colour};"


def mark_checked(btn: "QPushButton") -> None:
    """Flag a checkable button as a choice, so the theme can make its
    selected state unmistakable (filled accent + bold label).  Breeze's
    default checked button is only a few percent off the unchecked one —
    genuinely easy to miss at a laptop-screen angle, which is the only angle
    these buttons are ever seen from."""
    btn.setProperty("choice", True)


# Short names for the graphics mode.  core.MUX_LABELS spells out the full
# "Hybrid (Intel + NVIDIA)" for a button or a sentence; a dashboard row and a
# window title want the one word.
MUX_SHORT = {core.MUX_HYBRID: "Hybrid", core.MUX_DISCRETE: "Discrete"}


def graphics_mode(g: dict):
    """The mode to *display* — the running one, or the pending one loudly."""
    if not g:
        return None
    if g.get("reboot_required"):
        return g.get("requested")
    return g.get("effective") or g.get("requested")


def graphics_summary(g: dict) -> str | None:
    """One short phrase for the dashboard's "Right now" list."""
    mode = graphics_mode(g)
    if mode is None:
        return None
    name = MUX_SHORT.get(mode, mode)
    return f"{name} after reboot" if g.get("reboot_required") else name


# --------------------------------------------------------------------------
# daemon client — every request answered on the worker thread, delivered
# to the GUI as a queued Qt signal
# --------------------------------------------------------------------------

class Client(QObject):
    reply = Signal(dict)        # {tag, cmd, data?} or {tag, cmd, error}

    def __init__(self, parent=None):
        super().__init__(parent)
        self._q: queue.Queue = queue.Queue()
        threading.Thread(target=self._loop, daemon=True,
                         name="msi-control-client").start()

    def submit(self, cmd: dict, tag: str | None = None):
        cmd = dict(cmd)
        cmd["_tag"] = tag or str(cmd.get("cmd", "?"))
        self._q.put(cmd)

    def _loop(self):
        while True:
            cmd = self._q.get()
            tag = cmd.pop("_tag")
            try:
                data = core.call(cmd, timeout=5.0)
                self.reply.emit({"tag": tag, "cmd": cmd, "data": data})
            except Exception as e:                          # noqa: BLE001
                self.reply.emit({"tag": tag, "cmd": cmd, "error": str(e)})


