def _add_lib_path() -> str:
    """Find msi_control.py, whether run from the source tree or installed.

    Installed layout puts the shared module in /usr/local/lib/msi-control
    while the wrappers live in /usr/local/bin — so dirname(__file__) alone
    is not enough.
    """
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [here,
                  os.path.join(here, "..", "lib", "msi-control"),
                  "/usr/local/lib/msi-control",
                  "/usr/lib/msi-control"]
    for c in candidates:
        if os.path.isfile(os.path.join(c, "msi_control.py")):
            c = os.path.realpath(c)
            if c not in sys.path:
                sys.path.insert(0, c)
            return c
    sys.path.insert(0, here)
    return here


_add_lib_path()

