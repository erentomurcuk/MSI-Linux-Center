# small building blocks
# --------------------------------------------------------------------------

class QSignalBlockerSafe:
    """With-statement signal blocker that survives Qt object deletion."""

    def __init__(self, obj):
        self.obj = obj

    def __enter__(self):
        self.obj.blockSignals(True)

    def __exit__(self, *a):
        self.obj.blockSignals(False)


class Card(QFrame):
    """A titled surface with a tidy vertical layout — the GUI's layout atom.

    A plain QFrame + an uppercase caption rather than a QGroupBox: the
    groupbox title is drawn by the style at a size and colour we cannot
    control, which is what made the old tabs read as unstyled."""
    def __init__(self, title: str = "", parent=None):
        super().__init__(parent)
        self.setObjectName("Card")
        self.box = QVBoxLayout(self)
        self.box.setContentsMargins(SPACE * 2, 14, SPACE * 2, 14)
        self.box.setSpacing(SPACE + 2)
        self.header = QHBoxLayout()
        self.header.setSpacing(SPACE)
        self.title = QLabel(title.upper())
        self.title.setObjectName("CardTitle")
        f = ui_font(TYPE_CAPTION, bold=True)
        # A little tracking on the uppercase captions, so a row of card titles
        # reads as a set of labels rather than as small shouting body text.
        f.setLetterSpacing(QFont.SpacingType.PercentageSpacing, 108.0)
        self.title.setFont(f)
        self.header.addWidget(self.title)
        self.header.addStretch(1)
        if title:
            self.box.addLayout(self.header)


def kv_row(label: str, parent=None, value: str = "—",
           selectable: bool = False) -> tuple:
    """One label / right-aligned value row, styled in exactly one place.

    Every card that lists facts ("Right now", "System", the MUX state, the
    daemon) used to build this by hand, which is how their values drifted to
    different weights and alignments.  Returns ``(row_layout, value_label)``
    so the caller keeps a handle to update the value.
    """
    row = QHBoxLayout()
    row.setSpacing(SPACE + 2)
    k = QLabel(label)
    k.setFont(ui_font(TYPE_BODY))
    k.setStyleSheet(f"color:{muted_color(k)}")
    v = QLabel(value)
    v.setFont(ui_font(TYPE_BODY, bold=True))
    v.setAlignment(Qt.AlignRight | Qt.AlignVCenter)
    v.setWordWrap(True)
    if selectable:
        v.setTextInteractionFlags(Qt.TextSelectableByMouse)
    row.addWidget(k, 0)
    # The value takes the rest of the row and right-aligns inside it: giving
    # the *stretch* the slack instead hands the label its minimum width, and a
    # wrapping label then breaks a short string across two lines.
    row.addWidget(v, 1)
    return row, v


def stat_row(label: str, value: str, parent=None) -> tuple:
    """A label / big-number / unit row for a page headline (e.g. Battery)."""
    row = QHBoxLayout()
    row.setSpacing(SPACE)
    k = QLabel(label)
    k.setFont(ui_font(TYPE_BODY))
    k.setStyleSheet(f"color:{muted_color(k)}")
    v = QLabel(value)
    v.setFont(ui_font(TYPE_H1, bold=True))
    row.addWidget(k, 0, Qt.AlignBottom)
    row.addWidget(v, 0, Qt.AlignBottom)
    row.addStretch(1)
    return row, v


def field_label(text: str) -> QLabel:
    """The caption above a form field — defined in exactly one place, so the
    profile form and the raw console cannot label their fields differently."""
    lab = QLabel(text)
    lab.setFont(ui_font(TYPE_CAPTION, bold=True))
    lab.setStyleSheet(f"color:{muted_color(lab)}")
    return lab


class StatCard(Card):
    """Big number + progress bar + sub-line.  Every reading looks the same,
    so a glance down the row compares them instead of re-reading them."""

    def __init__(self, title: str, parent=None):
        super().__init__(title, parent)
        self.chip = QLabel("")
        self.chip.setObjectName("Chip")
        self.chip.setFont(ui_font(TYPE_MICRO, bold=True))
        self.chip.setVisible(False)
        self.header.addWidget(self.chip)

        self.value = QLabel("—")
        self.value.setFont(ui_font(TYPE_DISPLAY, bold=True))
        self.value.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        self.bar = QProgressBar()
        self.bar.setTextVisible(False)
        self.bar.setFixedHeight(H_BAR)
        self.sub = QLabel("")
        self.sub.setWordWrap(True)
        self.sub.setFont(ui_font(TYPE_BODY))
        self.sub.setStyleSheet(f"color:{muted_color(self)}")
        # Centred vertically so the card still looks composed when the
        # dashboard stretches it to fill the window.
        self.box.addStretch(1)
        self.box.addWidget(self.value)
        self.box.addWidget(self.bar)
        self.box.addWidget(self.sub)
        self.box.addStretch(1)

    def set_chip(self, text: str, colour: str | None = None) -> None:
        if not text:
            # Clear the style as well as the text: a hidden chip that keeps
            # the last colour is a surprise waiting for the first caller who
            # shows it without going through here.
            self.chip.setVisible(False)
            self.chip.setText("")
            self.chip.setStyleSheet("")
            return
        c = colour or THEME["accent"]
        self.chip.setText(text)
        self.chip.setStyleSheet(
            f"color:{text_on(c)};background:{c};border-radius:{R_PILL}px;"
            "padding:3px 9px;")
        self.chip.setVisible(True)

    def show(self, text: str, frac: float | None, sub: str,
             colour: str | None = None, chip: str | None = None,
             chip_colour: str | None = None):
        accent = colour or THEME["accent"]
        self.value.setText(text)
        self.value.setStyleSheet(f"color:{accent}")
        if frac is None:
            self.bar.setValue(0)
            self.bar.setEnabled(False)
        else:
            self.bar.setEnabled(True)
            self.bar.setRange(0, 1000)
            self.bar.setValue(int(max(0.0, min(1.0, frac)) * 1000))
        self.bar.setStyleSheet(
            f"QProgressBar{{background:{THEME['bar_bg']};border:none;"
            f"border-radius:{R_BAR}px}}"
            f"QProgressBar::chunk{{background:{accent};"
            f"border-radius:{R_BAR}px}}")
        self.sub.setText(sub)
        self.set_chip(chip or "", chip_colour)


def scrolled(page: QWidget) -> QScrollArea:
    """Put a page in a frameless, resizable scroll area.

    Every section scrolls, so the window can be made small on a laptop screen
    without a control sliding off the bottom."""
    sa = QScrollArea()
    sa.setWidgetResizable(True)
    sa.setFrameShape(QFrame.NoFrame)
    sa.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
    sa.setWidget(page)
    return sa


def page_layout(widget: QWidget) -> QVBoxLayout:
    """The standard page frame — one margin and one gap for all six sections.

    Every tab used to repeat the same three lines; centralising them is what
    keeps a card on the Dashboard aligned with a card on Settings."""
    lay = QVBoxLayout(widget)
    lay.setContentsMargins(PAGE_PAD, 18, PAGE_PAD, 18)
    lay.setSpacing(PAGE_GAP)
    return lay


# --------------------------------------------------------------------------
# fan-curve canvas — drag the six threshold points; the factory curve is
# drawn behind as a ghost so you can see how far you have strayed
# --------------------------------------------------------------------------

class CurveCanvas(QWidget):
    """Draggable fan-curve editor.

    Fully keyboard-operable, which the mouse-only first version was not:
    Tab reaches it, arrows select and move a point, Shift+arrows take bigger
    steps.  The same clamping as the mouse path is applied, so a keyboard
    drag can no more produce an invalid curve than a mouse one can.
    """

    changed = Signal()                       # user moved a point

    # The axes span the *whole* valid range, so a legal point can never be
    # drawn outside the plot.  TMIN used to be a hardcoded 20 while the EC
    # accepts down to core.TEMP_MIN (10): a keyboard nudge could then move
    # point 0 to 10 °C, which sits left of the plot — the handle vanished off
    # the edge and the mouse could no longer reach the value its own spin box
    # was showing.  Keep these tied to core, not to a taste call.
    TMIN, TMAX = core.TEMP_MIN, core.TEMP_MAX   # x axis, °C
    SMIN, SMAX = core.SPEED_MIN, core.SPEED_MAX  # y axis, %
    ML, MR, MT, MB = 40, 16, 16, 28          # margins
    STEP_FINE = 1
    STEP_COARSE = 5

    def __init__(self, which: str, parent=None):
        super().__init__(parent)
        self.which = which
        self.temps: list = []
        self.speeds: list = []
        self.ghost = None                    # factory {temps, speeds}
        self.live = None                     # (temp, fan%) from the EC
        self._drag: int | None = None
        self._hover: int | None = None
        self._kb: int | None = None          # keyboard-selected point
        self.setFocusPolicy(Qt.StrongFocus)
        self.setAccessibleName(f"{which.upper()} fan curve")
        self.setAccessibleDescription(
            "Editable fan curve.  Use the Tab key to reach it, the left and "
            "right arrow keys to choose a point, and the up and down arrow "
            "keys to change its fan speed.  Hold Shift for larger steps.")
        self.setMinimumHeight(230)

    # -- coordinate mapping -------------------------------------------------

    def _plot(self) -> QRectF:
        return QRectF(self.ML, self.MT,
                      self.width() - self.ML - self.MR,
                      self.height() - self.MT - self.MB)

    def _x(self, t: float) -> float:
        p = self._plot()
        return p.left() + (t - self.TMIN) / (self.TMAX - self.TMIN) * p.width()

    def _t(self, x: float) -> float:
        p = self._plot()
        return self.TMIN + (x - p.left()) / p.width() * (self.TMAX - self.TMIN)

    def _y(self, s: float) -> float:
        p = self._plot()
        return p.bottom() - (s - self.SMIN) / (self.SMAX - self.SMIN) * p.height()

    def _s(self, y: float) -> float:
        p = self._plot()
        return self.SMIN + (p.bottom() - y) / p.height() * (self.SMAX - self.SMIN)

    # -- data ---------------------------------------------------------------

    def set_curve(self, temps, speeds, ghost=None):
        self.temps = list(temps or [])
        self.speeds = list(speeds or [])
        if ghost is not None:
            self.ghost = ghost
        self.update()

    def set_live(self, live):
        self.live = live
        self.update()

    # -- painting -----------------------------------------------------------

    def _step_path(self, temps, speeds) -> QPainterPath:
        """Step function: speeds[0] until temps[0] is passed, then speeds[1] …"""
        path = QPainterPath()
        path.moveTo(self._x(self.TMIN), self._y(speeds[0]))
        for t, s in zip(temps, speeds[1:]):
            x = self._x(t)
            path.lineTo(x, path.currentPosition().y())
            path.lineTo(x, self._y(s))
        path.lineTo(self._x(self.TMAX), path.currentPosition().y())
        return path

    def paintEvent(self, ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        plot = self._plot()

        # inset panel, so the plot reads as its own surface inside the card
        p.setPen(Qt.NoPen)
        p.setBrush(tcol("surface2"))
        p.drawRoundedRect(QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5),
                          R_INNER, R_INNER)

        grid = tcol("border_strong")
        grid.setAlpha(150)
        p.setPen(QPen(grid, 1, Qt.DotLine))
        for t in range(self.TMIN, self.TMAX + 1, 10):
            p.drawLine(QPointF(self._x(t), plot.top()),
                       QPointF(self._x(t), plot.bottom()))
        for s in range(self.SMIN, self.SMAX + 1, 25):
            p.drawLine(QPointF(plot.left(), self._y(s)),
                       QPointF(plot.right(), self._y(s)))

        lab = tcol("muted")
        p.setPen(QPen(lab))
        p.setFont(ui_font(TYPE_MICRO))
        # Gridlines every 10 °C, but round-number labels only — the axis now
        # starts at core.TEMP_MIN (10), so 20…100 stay the natural labels.
        for t in (20, 40, 60, 80, 100):
            p.drawText(QRectF(self._x(t) - 14, plot.bottom() + 3, 28, 14),
                       Qt.AlignCenter, str(t))
        for s in (0, 50, 100):
            p.drawText(QRectF(0, self._y(s) - 7, self.ML - 8, 14),
                       Qt.AlignRight | Qt.AlignVCenter, str(s))
        p.drawText(QRectF(plot.left(), plot.bottom() + 15, plot.width(), 12),
                   Qt.AlignCenter, "°C")

        if self.temps and len(self.speeds) == core.N_SPEEDS:
            # The curve is *your setting*, so it wears the brand accent.  The
            # live position of the machine wears its temperature-band colour
            # instead, so "what I configured" and "how hot it is right now"
            # can never be mistaken for one another.  (The curve itself used
            # to be tinted by the live temperature — an identical curve then
            # changed colour from minute to minute, and the accent ended up
            # meaning nothing at all.)
            col = tcol("accent")

            if self.ghost:
                p.setPen(QPen(tcol("muted"), 1.4, Qt.DashLine))
                p.drawPath(self._step_path(self.ghost["temps"],
                                           self.ghost["speeds"]))

            path = self._step_path(self.temps, self.speeds)
            fill = QColor(col)
            fill.setAlpha(38)
            area = QPainterPath(path)
            area.lineTo(self._x(self.TMAX), self._y(self.SMIN))
            area.lineTo(self._x(self.TMIN), self._y(self.SMIN))
            area.closeSubpath()
            p.setPen(Qt.NoPen)
            p.setBrush(QBrush(fill))
            p.drawPath(area)

            p.setPen(QPen(col, 2.5))
            p.setBrush(Qt.NoBrush)
            p.drawPath(path)

            # Live marker: where the machine actually is right now — drawn in
            # the temperature band colour and labelled, so the one coloured
            # thing on the plot is the reading it stands for.
            if self.live and self.live[0] is not None:
                mark = QColor(temp_color(self.live[0]))
                p.setPen(QPen(mark, 1.5, Qt.DotLine))
                x = self._x(self.live[0])
                p.drawLine(QPointF(x, plot.top()), QPointF(x, plot.bottom()))
                txt = f"{self.live[0]}°C"
                if self.live[1] is not None:
                    txt += f" · {self.live[1]}%"
                fm = p.fontMetrics()
                w = fm.horizontalAdvance(txt) + 12
                bx = min(max(x + 5, plot.left()), plot.right() - w)
                p.setPen(Qt.NoPen)
                p.setBrush(QBrush(mark))
                p.drawRoundedRect(QRectF(bx, plot.top() + 4, w, 17), 6, 6)
                p.setPen(QPen(QColor(text_on(mark.name()))))
                p.drawText(QRectF(bx, plot.top() + 4, w, 17),
                           Qt.AlignCenter, txt)

            # draggable handles.  The keyboard-selected one gets a ring, so
            # focus is visible without relying on the style's focus rect —
            # which custom-painted widgets do not get for free.
            focused = self.hasFocus()
            ring = tcol("text")
            for i, (t, s) in enumerate(zip(self.temps, self.speeds[1:])):
                hot = i in (self._drag, self._hover)
                selected = focused and i == self._kb
                r = 6.5 if hot else 5.0
                cx, cy = self._x(t), self._y(s)
                if selected:
                    p.setPen(QPen(ring, 2))
                    p.setBrush(Qt.NoBrush)
                    p.drawEllipse(QPointF(cx, cy), r + 3.5, r + 3.5)
                p.setPen(QPen(col.darker(140) if hot else col, 2))
                p.setBrush(QBrush(col.lighter(130) if hot else col))
                p.drawEllipse(QPointF(cx, cy), r, r)
        else:
            p.setPen(QPen(lab))
            p.drawText(plot, Qt.AlignCenter, "no curve data")
        p.end()

    # -- interaction --------------------------------------------------------

    def _nearest(self, pos) -> int | None:
        best, bestd = None, 12.0
        for i, (t, s) in enumerate(zip(self.temps, self.speeds[1:])):
            d = ((self._x(t) - pos.x()) ** 2 + (self._y(s) - pos.y()) ** 2) ** .5
            if d < bestd:
                best, bestd = i, d
        return best

    def _set_point(self, i: int, t: int, s: int) -> bool:
        """Move point i, clamped to the monotonic envelope.

        Shared by the mouse and the keyboard so the two can never disagree
        about what a legal move is: a curve that fails validation on the way
        in is a curve the user cannot Apply, and clamping here means that
        can never happen from either input device.
        """
        lo_t = self.temps[i - 1] + 1 if i > 0 else core.TEMP_MIN
        hi_t = self.temps[i + 1] - 1 if i + 1 < len(self.temps) else core.TEMP_MAX
        lo_s = self.speeds[i]
        hi_s = self.speeds[i + 2] if i + 2 < len(self.speeds) else core.SPEED_MAX
        nt = max(lo_t, min(hi_t, t))
        ns = max(lo_s, min(hi_s, s))
        if nt == self.temps[i] and ns == self.speeds[i + 1]:
            return False                      # nothing actually moved
        self.temps[i] = nt
        self.speeds[i + 1] = ns
        return True

    def mousePressEvent(self, ev):
        self._drag = self._nearest(ev.position())
        if self._drag is not None:
            self._kb = self._drag
            self.setFocus()
            self.update()

    def mouseMoveEvent(self, ev):
        if self._drag is None:
            h = self._nearest(ev.position())
            if h != self._hover:
                self._hover = h
                self.setCursor(Qt.SizeAllCursor if h is not None
                               else Qt.ArrowCursor)
                self.update()
            return
        if self._set_point(self._drag,
                           round(self._t(ev.position().x())),
                           round(self._s(ev.position().y()))):
            self.update()
            self.changed.emit()

    def mouseReleaseEvent(self, ev):
        if self._drag is not None:
            self._drag = None
            self.update()
            self.changed.emit()

    def focusInEvent(self, ev):
        if self._kb is None and self.temps:
            self._kb = 0
        self.update()
        super().focusInEvent(ev)

    def focusOutEvent(self, ev):
        self._kb = None
        self.update()
        super().focusOutEvent(ev)

    def keyPressEvent(self, ev):
        if not self.temps or len(self.speeds) != core.N_SPEEDS:
            super().keyPressEvent(ev)
            return
        key = ev.key()
        step = (self.STEP_COARSE if ev.modifiers() & Qt.ShiftModifier
                else self.STEP_FINE)
        i = 0 if self._kb is None else self._kb

        if key in (Qt.Key_Left, Qt.Key_Right, Qt.Key_Up, Qt.Key_Down) \
                and ev.modifiers() & Qt.AltModifier:
            # Alt+arrows walk between points, matching the spin-box layout
            # where the points run left to right.
            self._kb = max(0, min(len(self.temps) - 1,
                                  i + (1 if key in (Qt.Key_Right, Qt.Key_Down)
                                       else -1)))
            self.update()
            ev.accept()
            return

        moved = False
        if key == Qt.Key_Left:
            moved = self._set_point(i, self.temps[i] - step,
                                    self.speeds[i + 1])
        elif key == Qt.Key_Right:
            moved = self._set_point(i, self.temps[i] + step,
                                    self.speeds[i + 1])
        elif key == Qt.Key_Up:
            moved = self._set_point(i, self.temps[i],
                                    self.speeds[i + 1] + step)
        elif key == Qt.Key_Down:
            moved = self._set_point(i, self.temps[i],
                                    self.speeds[i + 1] - step)
        else:
            super().keyPressEvent(ev)
            return

        if moved:
            self.update()
            self.changed.emit()
        ev.accept()

    def leaveEvent(self, ev):
        if self._hover is not None:
            self._hover = None
            self.setCursor(Qt.ArrowCursor)
            self.update()


