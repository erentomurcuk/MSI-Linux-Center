        self.raw_addr.setPlaceholderText("0xf4")
        self.raw_addr.setFixedWidth(92)
        self.raw_addr.setAccessibleName("EC address")
        self.raw_addr.setToolTip("EC address in hex, e.g. 0xf4")
        self.raw_val = QLineEdit()
        self.raw_val.setPlaceholderText("value (write)")
        self.raw_val.setFixedWidth(120)
        self.raw_val.setAccessibleName("EC value")
        self.raw_val.setToolTip("Value to write, in hex (leave empty to read)")
        self.raw_read = QPushButton("Read")
        self.raw_read.setToolTip("Read the byte at the address above")
        self.raw_read.clicked.connect(lambda: self._raw(None))
        self.raw_write = QPushButton("Write")
        self.raw_write.setToolTip("Write the value into the address above")
        self.raw_write.clicked.connect(lambda: self._raw(True))
