def _palette(t: dict) -> QPalette:
    pal = QPalette()
    C, G = QPalette.ColorRole, QPalette.ColorGroup
    pal.setColor(C.Window, QColor(t["bg"]))
    pal.setColor(C.WindowText, QColor(t["text"]))
    pal.setColor(C.Base, QColor(t["surface"]))
    pal.setColor(C.AlternateBase, QColor(t["surface2"]))
    pal.setColor(C.Text, QColor(t["text"]))
    pal.setColor(C.Button, QColor(t["surface2"]))
    pal.setColor(C.ButtonText, QColor(t["text"]))
    pal.setColor(C.Highlight, QColor(t["accent"]))
    pal.setColor(C.HighlightedText, QColor(t["on_accent"]))
    pal.setColor(C.ToolTipBase, QColor(t["surface3"]))
    pal.setColor(C.ToolTipText, QColor(t["text"]))
    pal.setColor(C.PlaceholderText, QColor(t["muted"]))
    pal.setColor(G.Disabled, C.WindowText, QColor(t["muted"]))
    pal.setColor(G.Disabled, C.Text, QColor(t["muted"]))
    pal.setColor(G.Disabled, C.ButtonText, QColor(t["muted"]))
    return pal


def resolve_theme(app) -> str:
    """`MSI_THEME` wins; else the desktop's scheme; else dark."""
    env = os.environ.get("MSI_THEME", "").strip().lower()
    if env in ("light", "dark"):
        return env
    try:
        scheme = app.styleHints().colorScheme()
        if scheme == Qt.ColorScheme.Light:
            return "light"
        if scheme == Qt.ColorScheme.Dark:
            return "dark"
    except Exception:                                       # noqa: BLE001
        pass
    # Unknown (offscreen platforms, exotic desktops): dark is the default
    # this app is designed around, and it never looks broken.
    return "dark"


def apply_theme(app=None, force: str | None = None) -> str:
    """Install the palette + stylesheet.  Safe to call more than once."""
    global THEME
    app = app or QApplication.instance()
    if app is None:
        return "dark"
    name = force or resolve_theme(app)
    THEME = THEMES.get(name, THEMES["dark"])
    app.setPalette(_palette(THEME))
    app.setStyleSheet(QSS % THEME)
    app.setProperty("msi_theme", THEME["name"])
    return THEME["name"]


def tcol(key: str) -> QColor:
