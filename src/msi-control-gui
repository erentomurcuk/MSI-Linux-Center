def ui_font(px: int, *, bold: bool = False, italic: bool = False) -> QFont:
    """One helper for every explicitly-sized label.

    Sizes are pixels, never points.  The GUI used to mix `setPointSize` and
    `setPixelSize`, so the same nominal "big" number rendered at two different
    heights depending on which widget happened to draw it.
    """
    f = QFont()
    f.setPixelSize(px)
    f.setBold(bold)
    f.setItalic(italic)
    return f


def mono_font(px: int = TYPE_CAPTION) -> QFont:
    """A fixed-width font for the data views (config JSON, raw EC console).

    Machine output in a proportional face is harder to scan and misaligns
    columns; every other code surface on the desktop is monospaced.
    """
    f = ui_font(px)
    f.setStyleHint(QFont.StyleHint.Monospace)
    f.setFamily("monospace")
    return f


def _srgb(v: float) -> float:
    return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4


def text_on(background: str) -> str:
    """Black or white text, whichever is readable on `background`.

    White on the amber "hot" colour measures ~2.9:1 — it looks fine in a
    mockup and fails WCAG AA in use.  Luminance decides, not habit.
    """
    c = QColor(background)
    lum = (0.2126 * _srgb(c.redF()) + 0.7152 * _srgb(c.greenF())
           + 0.0722 * _srgb(c.blueF()))
    return "#000000" if lum > 0.18 else "#ffffff"


def _rgba(hex_color: str, alpha: float) -> str:
    c = QColor(hex_color)
    return f"rgba({c.red()},{c.green()},{c.blue()},{alpha:.3f})"


def muted_color(widget) -> str:
    """Readable secondary text, derived from the live palette.

    A hardcoded grey is a lie in whichever theme you did not test it in —
    rgba(160,160,160) is nearly invisible on a light background.  Blend the
    real foreground 60% towards the real background instead: that measures
    ~4.0:1 on light and ~5.5:1 on dark.
    """
    pal = widget.palette()
    fg = pal.color(pal.ColorRole.WindowText)
    bg = pal.color(pal.ColorRole.Window)
    return QColor(*[round(f * 0.6 + b * 0.4)
                    for f, b in ((fg.red(), bg.red()),
                                 (fg.green(), bg.green()),
                                 (fg.blue(), bg.blue()))]).name()


