def _theme(base: dict) -> dict:
    """Add the derived tokens a theme needs on top of its base colours."""
    t = dict(base)
    dark = t["name"] == "dark"
    t["on_accent"] = text_on(t["accent"])
    t["accent_soft"] = _rgba(t["accent"], 0.18 if dark else 0.12)
    t["accent_ink"] = ("#ffb0aa" if dark else "#a30d25")
    t["accent_line"] = t["accent"]
    t["bar_bg"] = ("rgba(255,255,255,0.10)" if dark else "rgba(0,0,0,0.09)")
    t["scroll"] = ("rgba(255,255,255,0.16)" if dark else "rgba(0,0,0,0.16)")
    t["scroll_hover"] = ("rgba(255,255,255,0.30)" if dark else "rgba(0,0,0,0.30)")
    t["crit"] = COL_CRIT
    t["crit_soft"] = _rgba(COL_CRIT, 0.14)
    # Shape tokens, as QSS length strings so the stylesheet can interpolate
    # them the same way it interpolates colour.
    t["r_card"], t["r_ctrl"], t["r_inner"] = (f"{R_CARD}px", f"{R_CTRL}px",
                                              f"{R_INNER}px")
    t["r_pill"], t["r_bar"] = f"{R_PILL}px", f"{R_BAR}px"
    t["pad_ctrl_v"] = f"{PAD_CTRL_V}px"
    t["pad_hero_v"] = f"{PAD_HERO_V}px"
    t["h_ctrl"], t["h_spin"] = f"{H_CTRL}px", f"{H_SPIN}px"
    return t


