class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        apply_theme(QApplication.instance())

        self.setWindowTitle("MSI Linux Control")
        self.online = None                  # None = not yet heard from it
        self.profile_cache: dict = {}
        self._pending_status = False
        self._conn_note = "connecting…"      # the status bar's permanent text

        # Window size and the section you last looked at, remembered across
        # launches.  For an app opened repeatedly to check one number, a
        # window that forgets both every time is the most-returned-to
        # annoyance there is.  Scoped to this app and written only on a
        # real close, so a hide-to-tray never saves a hidden state.
        self._qs = QSettings("msi-control", "msi-control")

        self.client = Client(self)
        self.client.reply.connect(self._on_reply)

        self.dash = DashboardTab(self)
        self.perf = PerformanceTab(self)
        self.fans = FansTab(self)
        self.batt = BatteryTab(self)
        self.profs = ProfilesTab(self)
        self.settings = SettingsTab(self)

        self.tabs = NavStack()
        for page, label in ((self.dash, "Dashboard"),
                            (self.perf, "Performance"),
                            (self.fans, "Fans"),
                            (self.batt, "Battery"),
                            (self.profs, "Profiles"),
                            (self.settings, "Settings")):
            self.tabs.addTab(scrolled(page), label)

        self.header = Header(self)
        self.banner = Banner(self)
        self.model_banner = ModelBanner(self)
        self.sidebar = Sidebar(self)
        self.tabs.currentChanged.connect(self.sidebar.sync)
        self.sidebar.sync(0)

        root = QWidget()
        root.setObjectName("Root")
        rl = QVBoxLayout(root)
        rl.setContentsMargins(0, 0, 0, 0)
        rl.setSpacing(0)
        rl.addWidget(self.header)
        rl.addWidget(self.banner)
        rl.addWidget(self.model_banner)
        body = QHBoxLayout()
        body.setContentsMargins(0, 0, 0, 0)
        body.setSpacing(0)
        body.addWidget(self.sidebar)
        body.addWidget(self.tabs, 1)
        rl.addLayout(body, 1)
        self.setCentralWidget(root)

        # Restore after the tabs exist, so the saved index has somewhere to
        # land.  A saved index that is out of range is ignored rather than
        # clamped: a stale 6 in a 6-section stack is a guess, not a
        # preference.
        saved_tab = self._qs.value("tab", type=int)
        if isinstance(saved_tab, int) and 0 <= saved_tab < self.tabs.count():
            self.tabs.setCurrentIndex(saved_tab)
        geo = self._qs.value("geometry")
        if geo is not None:
            self.restoreGeometry(geo)
        else:
            self.resize(1180, 780)
        self.setMinimumSize(940, 640)

        sb = QStatusBar()
        sb.setSizeGripEnabled(False)
        # What we are talking to lives here permanently.  This used to be
        # pushed as a *transient* message on every poll — and the poll is
        # 1.5 s — so an action's confirmation ("shift → turbo") was wiped off
        # the bar within a second and a half of appearing, and a slow reply
        # never showed at all.
        self.status_info = QLabel("connecting…")
        self.status_info.setFont(ui_font(TYPE_CAPTION))
        self.status_info.setStyleSheet(
            f"color:{muted_color(self.status_info)};padding:0 {SPACE}px")
        sb.addPermanentWidget(self.status_info)
        self.setStatusBar(sb)
        self.setWindowIcon(QIcon(brand_pixmap(64)))

        self._install_shortcuts()

        self.tray = None
        if QSystemTrayIcon.isSystemTrayAvailable():
            self.tray = QSystemTrayIcon(self)
            self.tray.setIcon(QIcon(brand_pixmap(64)))
            self.tray.setToolTip("MSI Linux Control")
            self.tray.activated.connect(self._tray_activated)
            # A context menu is not decoration here: closing the window
            # only hides it (see closeEvent), so without this a user whose
            # desktop does not surface the icon has no way back in *and* no
            # way to quit.  Show and Quit are the two that matter.
            menu = QMenu()
            show_act = menu.addAction("Show window")
            show_act.triggered.connect(self._show_window)
            menu.addSeparator()
            quit_act = menu.addAction("Quit")
            quit_act.triggered.connect(QApplication.quit)
            self.tray.setContextMenu(menu)
            self.tray.show()
            QApplication.setQuitOnLastWindowClosed(False)

        self.poll = QTimer(self)
        self.poll.timeout.connect(self.poll_status)
        self.poll.start(POLL_MS)
        self.poll_status()

    def _install_shortcuts(self):
        def cut(seq, slot):
            sc = QShortcut(QKeySequence(seq), self)
            sc.activated.connect(slot)
            return sc
        self._cuts = [cut("Ctrl+Q", self.close),
                      cut("Ctrl+R", self.poll_status)]
        for i in range(len(Sidebar.ITEMS)):
            self._cuts.append(cut(
                f"Ctrl+{i + 1}", lambda i=i: self.tabs.setCurrentIndex(i)))

    # -- plumbing -----------------------------------------------------------

    def send(self, cmd: dict, tag: str | None = None):
        self.client.submit(cmd, tag)

    def poll_status(self):
        if self._pending_status:
            return                      # never queue two polls
        self._pending_status = True
        self.client.submit({"cmd": "status"}, tag="status")

    def flash(self, text: str, ok: bool = False):
        """Report an outcome.  Status bar always; desktop notification only
        for failures.

        Notifying on every success is noise the user learns to ignore — and
        a tray balloon for "shift eco" is not worth interrupting them for.
        A failure, on the other hand, is exactly what a notification is for:
        the window may well be hidden behind the game that just spiked the
        fans.
        """
        self.statusBar().showMessage(text, 8000)
        if not ok and self.tray:
            self.tray.showMessage("MSI Linux Control — failed", text,
                                  QSystemTrayIcon.Warning)

    def set_key(self, key: str, value):
        self.send({"cmd": "set", "key": key, "value": value})

    def _sync_connection(self):
        self.header.set_online(self.online)
        self.banner.setVisible(self.online is False)
        self.status_info.setText(self._conn_note)
        self.status_info.setStyleSheet(
            (f"color:{COL_CRIT}" if self.online is False
             else f"color:{muted_color(self.status_info)}")
            + f";padding:0 {SPACE}px")

    def _on_reply(self, msg: dict):
        tag, cmd = msg.get("tag"), msg.get("cmd", {})

        if tag == "status":
            self._pending_status = False
            if "error" in msg:
                # degraded: read what we can locally, say so, keep trying.
                # The reason goes to the permanent readout rather than a
                # transient message, so it is still visible ten seconds later
                # — which is when you actually look for it.
                self.online = False
                st = core.local_status()
                self._refresh(st,
                              note=f"offline — read-only ({msg['error'][:60]})")
                return
            self.online = True
            self._refresh(msg["data"])
            return

        if tag == "factory":
            # read-only fetch of the factory profile body (see _refresh)
            if "data" in msg:
                self.profile_cache["factory"] = msg["data"]
                self.fans.refresh_factory()
            return

        # anything else was an action.  The daemon reads every setting back
        # before and after writing it, so its `summary` describes the
        # hardware rather than our intention — use it verbatim.
        data = msg.get("data") or {}
        if "error" in msg:
            self.flash(f"✗ {msg['error']}", ok=False)
        elif cmd.get("cmd") == "raw":
            self.settings.raw_out.setText(
                f"0x{cmd['addr']:02x} = 0x{data.get('val', 0):02x} "
                f"({data.get('val', 0)})")
            self.flash(f"0x{cmd['addr']:02x} = 0x{data.get('val', 0):02x}",
                       ok=True)
        else:
            self.flash(self._action_message(cmd, data, tag), ok=True)
        self.poll_status()              # re-read so the UI shows EC truth

    @staticmethod
    def _action_message(cmd: dict, data: dict, tag) -> str:
        """One honest sentence about what an action actually did.

        The daemon reads every setting back before and after writing it, so
        its `activity` describes the hardware, not our intention.  It is
        phrased as what the person just did ("Set charge limit to 80%",
        "Enabled cooler boost"), which is what a status bar or a tray
        balloon should say — the `a -> b` diff form stays available for
        --json consumers but is the wrong shape for a notification.
        """
        activity = data.get("activity")
        if activity:
            return activity
        summary = data.get("summary")
        if summary:
            return summary
        kind, action = cmd.get("cmd"), cmd.get("action")
        if kind == "set":
            return core.describe_activity(cmd.get("key"),
                                          data.get("was"), data.get("now"))
        if kind == "curve":
            return f"{cmd.get('which', 'fan')} curve written"
        if kind == "profile":
            name = cmd.get("name") or "profile"
            what = {"apply": "Applied", "save-current": "Saved",
                    "save": "Saved", "delete": "Deleted"}.get(
                        action, action or "")
            msg = f"{what} profile {name}"
            # A profile apply that changed nothing must not read as if the
            # hardware moved — the daemon tells us via `changes`.
            if action == "apply" and data.get("changes") is not None \
                    and not data["changes"]:
                msg += " — nothing to change"
            return msg
        if kind == "reapply":
            return "Re-applied settings"
        if kind == "capture-factory":
            return "Captured factory profile"
        # `tag` is optional and can be None; never call .replace on it.
        return (tag or "done").replace(":", " ") or "done"

    def _refresh(self, st: dict, note: str | None = None):
        # The status bar's permanent readout is a property of the state we
        # were just handed, so it is derived here rather than remembered from
        # whichever reply happened to arrive first.  `note` overrides it for
        # the one case the state cannot describe: a daemon that did not
        # answer and the reason why.
        self._conn_note = note or self._conn_note_of(st)
        # Cache the factory profile body once, so the fans tab can draw it as
        # a ghost under the editable curve.  "show" is read-only — never
        # "apply", which would push settings into the EC as a side effect.
        profs = st.get("profiles") or {}
        if "factory" in (profs.get("saved") or []) \
                and "factory" not in self.profile_cache:
            self.client.submit({"cmd": "profile", "action": "show",
                                "name": "factory"}, tag="factory")
        self.dash.refresh(st)
        self.perf.refresh(st)
        self.fans.refresh(st)
        self.batt.refresh(st)
        self.profs.refresh(st)
        self.settings.refresh(st)
        self._sync_connection()
        if self.tray:
            t = (st.get("cpu", {}).get("temp"), st.get("gpu", {}).get("temp"))
            worst = max([x for x in t if x is not None], default=None)
            # Brand mark until there is a reading to show, then the same mark
            # tinted by the hottest sensor with the number on it.
            self.tray.setIcon(QIcon(brand_pixmap(64) if worst is None
                                    else temp_pixmap(64, worst, str(worst))))
            self.tray.setToolTip(
                f"MSI · CPU {t[0] if t[0] is not None else '?'}°C · "
                f"GPU {t[1] if t[1] is not None else '?'}°C")

    @staticmethod
    def _conn_note_of(st: dict) -> str:
        """One line naming what we are talking to — the status bar's right
        hand side, where it stays instead of being overwritten every poll."""
        drv = st.get("driver") or {}
        return " · ".join(x for x in (
            "msi-controld",
            f"fw {drv['fw']}" if drv.get("fw") else "",
            "driver not loaded" if drv.get("present") is False else "",
            "partial" if st.get("partial") else "",
        ) if x)

    def _show_window(self):
        self.show()
        self.raise_()
        self.activateWindow()

    def _tray_activated(self, reason):
        if reason == QSystemTrayIcon.Trigger:
            if self.isVisible():
                self.hide()
            else:
                self._show_window()

    def closeEvent(self, ev):
        if self.tray and self.tray.isVisible():
            self.hide()
            ev.ignore()
            return
        # A real quit: remember where the window was and which section was
        # open.  Deliberately not done on the hide path above — saving there
        # would persist a hidden window and a section the user never chose
        # to leave.
        self._qs.setValue("geometry", self.saveGeometry())
        self._qs.setValue("tab", self.tabs.currentIndex())
        self._qs.sync()
        super().closeEvent(ev)


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("msi-control")
    apply_theme(app)
    win = MainWindow()
    win.show()

    # Clean Ctrl-C exit: a plain default handler would raise inside the Qt
    # event loop, so ask the window to close and quit the loop instead.
    def _on_sigint(*_a):
        app.quit()

    signal.signal(signal.SIGINT, _on_sigint)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())

