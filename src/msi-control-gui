        self.raw_out.setTextInteractionFlags(Qt.TextSelectableByMouse)
        self.raw_out.setFont(mono_font(TYPE_BODY))
        raw.box.addWidget(self.raw_out)
        raw.box.addWidget(hint_label(
            "Unvalidated EC access.  One wrong byte here can crash the "
            "embedded controller and the machine with it — which is why it "
            "is off unless AllowRaw is set in the config.", raw))
        lay.addWidget(raw)
        lay.addStretch(1)

    def _reapply(self):
        self.win.send({"cmd": "reapply"})

    def _factory(self):
        self.win.send({"cmd": "capture-factory"})

    def _raw(self, write):
        try:
            addr = int(self.raw_addr.text(), 0)
        except ValueError:
            self.win.flash("address must be a number, e.g. 0xf4")
            return
        cmd = {"cmd": "raw", "addr": addr}
        if write is not None:
            try:
                cmd["val"] = int(self.raw_val.text(), 0)
            except ValueError:
                self.win.flash("value must be a number, e.g. 0x0d")
                return
        self.win.send(cmd, tag="raw")

    def refresh(self, st: dict):
        drv = st.get("driver", {})
        model = st.get("model") or core.MODEL.summary()
        if model.get("supported"):
            self._daemon_rows["Model"].setText(
                f"{model.get('name')}  ·  {model.get('id')}  "
                f"·  {model.get('status')}")
        else:
            self._daemon_rows["Model"].setText(
                "unrecognised — no model file matches this laptop")
        errs = core.model_errors()
        if errs:
            self._daemon_rows["Model file"].setText(
                f"{core.models_dir()}  ·  ⚠ {len(errs)} broken file(s): "
                + "; ".join(errs))
        else:
            self._daemon_rows["Model file"].setText(
                core.MODEL.source or f"none — registry: {core.models_dir()}")
        self._daemon_rows["Socket"].setText(core.sock_path())
        self._daemon_rows["Driver"].setText(
            (f"loaded · {drv.get('fw')}" if drv.get("present")
             else "NOT LOADED")
            + (" · debug interface on" if drv.get("debug") else ""))
        self._daemon_rows["State directory"].setText(core.state_dir())
        cfg = st.get("config") or {}
        self.cfg_text.setPlainText(json.dumps(cfg, indent=2, sort_keys=True))
        # Re-apply and capture-factory are daemon writes; disable them with
        # the daemon, same as every other writer in the app.
        online = bool(self.win.online)
        self.reapply_btn.setEnabled(online)
        curve_ok = core.feature("fan_curve")
        self.factory_btn.setEnabled(online and curve_ok)
        self.factory_btn.setToolTip("" if curve_ok else
                                    "this laptop has no fan-curve registers "
                                    "in the registry, so there is nothing to "
                                    "capture")
        # Fit the box to the text so a read-only dump has no scrollbar, but
        # cap it so a future key cannot push the raw console off the tab.
        # Measured from the line count and the font, NOT from
        # QTextDocument.size(): an unshown document reports its (lazy, wrong)
        # layout size — 8 px for an eight-line dump — which is how the box
        # ended up one line tall with a scrollbar behind it.
        fm = self.cfg_text.fontMetrics()
        lines = max(1, self.cfg_text.document().blockCount())
        self.cfg_text.setFixedHeight(min(lines * fm.lineSpacing() + 26, 260))
        if not cfg.get("AllowRaw"):
            note, enabled = "raw access is disabled (AllowRaw: false)", False
        elif not self.win.online:
            note, enabled = "raw access allowed, but the daemon is offline", False
        else:
            note, enabled = "raw access is ENABLED — be careful", True
        self.allow_raw.setText(note)
        self.allow_raw.setStyleSheet(
            f"color:{COL_WARM}" if enabled else f"color:{muted_color(self)}")
        # The two raw fields directly — no findChildren walk over widgets
        # we already hold by name.
        for w in (self.raw_addr, self.raw_val,
                  self.raw_read, self.raw_write):
            w.setEnabled(enabled)


