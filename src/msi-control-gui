class DashboardTab(QWidget):
    def __init__(self, win, parent=None):
        super().__init__(parent)
        self.setObjectName("Page")
        self.win = win
        lay = page_layout(self)

        self.cpu = StatCard("CPU")
        self.gpu = StatCard("GPU")
        self.cpu_rpm = StatCard("CPU fan")
        self.gpu_rpm = StatCard("GPU fan")
        self.battery = StatCard("Battery")

        grid = QGridLayout()
        grid.setSpacing(PAGE_GAP)
        grid.addWidget(self.cpu, 0, 0)
        grid.addWidget(self.gpu, 0, 1)
        grid.addWidget(self.cpu_rpm, 0, 2)
        grid.addWidget(self.gpu_rpm, 0, 3)
        grid.addWidget(self.battery, 1, 0, 1, 2)
        self.modes = Card("Right now")
        grid.addWidget(self.modes, 1, 2, 1, 2)
        for c in range(4):
            grid.setColumnStretch(c, 1)
        lay.addLayout(grid)

        self.syscard = Card("System")
        self.sys_rows = {}
        for key in ("Model", "Driver", "Socket", "Debug interface", "Config"):
            row, v = kv_row(key, self.syscard, selectable=True)
            self.syscard.box.addLayout(row)
            self.sys_rows[key] = v
        self.syscard.box.addWidget(hint_label(
            "Read from the daemon's own status, not from sysfs: this window "
            "never opens the hardware directly.", self.syscard))
        lay.addWidget(self.syscard)
        lay.addStretch(1)

        self.mode_rows = {}
        for label in ("Performance", "Fan mode", "Cooler boost",
                      "Charge limit", "Graphics"):
            row, v = kv_row(label, self.modes)
            self.modes.box.addLayout(row)
            self.mode_rows[label] = v

    def refresh(self, st: dict):
        cpu, gpu = st.get("cpu", {}), st.get("gpu", {})
        for card, d in ((self.cpu, cpu), (self.gpu, gpu)):
            t = d.get("temp")
            pct = d.get("fan_pct")
            band = core.temp_band(t)
            card.show(f"{t}°C" if t is not None else "—",
                      (t / 100.0) if t is not None else None,
                      f"fan {pct}%" if pct is not None else "fan —",
                      temp_color(t),
                      chip=(band or "").upper(),
                      chip_colour=temp_color(t))
        for card, d in ((self.cpu_rpm, cpu), (self.gpu_rpm, gpu)):
            rpm = d.get("rpm")
            pct = d.get("fan_pct")
            # `is not None`, not truthiness: a stopped fan reads 0 RPM and
            # that is a real answer, not a missing daemon.
            if rpm is None:
                sub = ("RPM off — no model definition for this laptop"
                       if not core.feature("rpm") else "RPM needs the daemon")
                card.show("—", None, sub, COL_DEAD)
            else:
                # The bar is fan duty, the number is RPM — say so.  With the
                # sub-line just reading "RPM" the bar's meaning was anyone's
                # guess, and it does not track the number beside it.
                card.show(f"{rpm:,}", (pct / 100.0) if pct is not None else None,
                          f"RPM · fan {pct}%" if pct is not None else "RPM",
                          temp_color(d.get("temp")))

        bat = st.get("battery") or {}
        pct = bat.get("pct")
        # Wear is *capacity now* against *capacity when new*.  This used to be
        # energy_now / energy_full, which is the state of charge — so the
        # dashboard announced "67% of new" beside a big 67% and told you
        # nothing about the battery's health at all.
        wear = None
        if bat.get("energy_full") and bat.get("energy_full_design"):
            wear = bat["energy_full"] / bat["energy_full_design"]
        limit = bat.get("charge_end")
        status = (bat.get("status") or "").strip()
        word = status.lower()
        # The chip names the state and colours it by whether it wants your
        # attention.  Charging and full are simply fine (green); "not
        # charging" while on AC is the one state people actually ask about —
        # usually the charge limit doing its job — so it takes the amber that
        # means "look, but nothing is wrong"; everything else, including
        # running on battery, is neutral.
        if word in ("charging", "full"):
            chip_col = COL_OK
        elif word in ("not charging", "unknown"):
            chip_col = COL_WARM
        else:
            chip_col = THEME["accent"]
        # The battery is not a temperature, so it does not wear the heat-map
        # colours; it wears the brand accent, which is what the app uses for
        # "a value we are reporting" everywhere else.  (It used to be green
        # whatever the charge was, so 8% on battery looked as "fine" as 100%.)
        self.battery.show(
            f"{pct}%" if pct is not None else "—",
            (pct / 100.0) if pct is not None else None,
            " · ".join(x for x in [
                "AC" if bat.get("ac_online") else ("battery" if bat.get(
                    "ac_online") is not None else ""),
                f"health {wear:.0%}" if wear else "",
                f"limit {limit}%" if limit is not None else "",
            ] if x),
            THEME["accent"],
            chip=(status.upper() if status else ""),
            chip_colour=chip_col)

        rows = {
            "Performance": st.get("shift", {}).get("current"),
            "Fan mode": st.get("fan", {}).get("current"),
            "Cooler boost": st.get("cooler_boost"),
            "Charge limit": (f"{limit}%" if limit is not None else None),
            "Graphics": graphics_summary(st.get("graphics") or {}),
        }
        for k, v in rows.items():
            self.mode_rows[k].setText(str(v) if v else "—")

        drv = st.get("driver") or {}
        model = st.get("model") or core.MODEL.summary()
        feats = model.get("features") or {}
        on = [k for k in ("fan_curve", "rpm", "mux") if feats.get(k)]
        self.sys_rows["Model"].setText(
            (f"{model.get('name')}  ·  {model.get('id')}"
             + (f"  ·  curve/rpm/mux: {len(on)}/3" if on else
                "  ·  no fan-curve, RPM or MUX definition"))
            if model.get("supported") else
            "unrecognised — no model file matches this laptop")
        self.sys_rows["Driver"].setText(
            (f"{drv.get('fw') or 'driver'}"
             + (f"  ·  {drv['fw_date']}" if drv.get("fw_date") else ""))
            if drv.get("present") else "NOT LOADED  (see Settings)")
        self.sys_rows["Socket"].setText(core.sock_path())
        self.sys_rows["Debug interface"].setText(
            "on" if drv.get("debug") else "off")
        cfg = st.get("config") or {}
        bits = []
        if cfg:
            bits.append("raw access " + ("ON" if cfg.get("AllowRaw") else "off"))
            bits.append("MUX switch "
                        + ("ON" if cfg.get("AllowMuxSwitch") else "off"))
        self.sys_rows["Config"].setText("  ·  ".join(bits) or "—")


class PerformanceTab(QWidget):
    def __init__(self, win, parent=None):
        super().__init__(parent)
        self.setObjectName("Page")
        self.win = win
        lay = page_layout(self)

        card = Card("Performance mode (shift)")
        self.note = hint_label(
            "MSI's shift modes trade sustained performance against heat and "
            "fan noise.  Changes reach the EC immediately.", card)
        card.box.addWidget(self.note)
        self.btns = QButtonGroup(self)
        self.btns.setExclusive(True)
        row = QHBoxLayout()
        row.setSpacing(SPACE)
        self.buttons = {}
        for name in ("eco", "comfort", "sport", "turbo"):
            b = QPushButton(name.capitalize())
            b.setCheckable(True)
            mark_checked(b)
            b.clicked.connect(lambda _=False, n=name: self.win.set_key("shift", n))
            self.btns.addButton(b)
            self.buttons[name] = b
            row.addWidget(b)
        card.box.addLayout(row)
        card.box.addWidget(hint_label(
            "eco · quiet and cool — comfort · everyday — sport · sustained "
            "load — turbo · maximum (loud)", card))
        lay.addWidget(card)

        boost = Card("Cooling")
        self.boost_btn = QPushButton("COOLER BOOST — hold both fans at 100%")
        self.boost_btn.setCheckable(True)
        # The one oversized control in the app: its height comes from the
        # [hero="true"] rule in the stylesheet, so it is a token like every
        # other size rather than a number set here.
        self.boost_btn.setProperty("hero", True)
        self.boost_btn.setFont(ui_font(TYPE_H2, bold=True))
        self.boost_btn.setCursor(Qt.PointingHandCursor)
        self.boost_btn.clicked.connect(self._boost)
        boost.box.addWidget(self.boost_btn)
        boost.box.addWidget(hint_label(
            "Forced maximum cooling, e.g. right after a gaming session.  "
            "It stays on until you turn it off (or the daemon re-applies "
            "your saved state at boot).  The duty registers do not move under "
            "Cooler Boost — watch the RPM beside them.", boost))
        lay.addWidget(boost)

        # ---- graphics mode (MUX) -----------------------------------------
        # Same place MSI Center puts "Graphics Switch", and the same trade:
        # discrete is faster and hybrid is cooler and longer-running.
        gfx = Card("Graphics mode (MUX)")
        gfx.box.addWidget(hint_label(
            "Which GPU drives the built-in display.  A switch is written to "
            "the embedded controller and to a UEFI variable, and takes effect "
            "at the next reboot — this session is unaffected.", gfx))

        self.gfx_rows = {}
        for label in ("running now", "at next boot"):
            row, v = kv_row(label, gfx)
            gfx.box.addLayout(row)
            self.gfx_rows[label] = v

        grow = QHBoxLayout()
        grow.setSpacing(SPACE)
        self.gfx_btns = QButtonGroup(self)
        self.gfx_btns.setExclusive(True)
        self.gfx_buttons = {}
        for mode in core.MUX_MODES:
            b = QPushButton(core.MUX_LABELS[mode])
            b.setCheckable(True)
            mark_checked(b)
            b.clicked.connect(lambda _=False, m=mode: self._graphics(m))
            self.gfx_btns.addButton(b)
            self.gfx_buttons[mode] = b
            grow.addWidget(b, 1)
        self.gfx_revert = QPushButton("Undo last switch")
        self.gfx_revert.clicked.connect(self._graphics_revert)
        grow.addWidget(self.gfx_revert, 0)
        gfx.box.addLayout(grow)

        self.gfx_warn = QLabel("")
        self.gfx_warn.setWordWrap(True)
        self.gfx_warn.setVisible(False)
        gfx.box.addWidget(self.gfx_warn)
        gfx.box.addWidget(hint_label(
            "⚠ A switch rewrites EC 0x2e and the UEFI variable "
            f"{core.MUX_VAR_NAME}.  It is off unless “AllowMuxSwitch” is set "
            "in the config, it always needs a reboot, and on a laptop whose "
            "MUX was never reverse engineered it can leave the machine with "
            "no display — recovery would then mean resetting the firmware.  "
            "The previous value is backed up first.", gfx))
        lay.addWidget(gfx)
        lay.addStretch(1)

        self._avail = []
        self._gfx: dict = {}

    def _boost(self):
        self.win.set_key("cooler_boost", self.boost_btn.isChecked())

    def _graphics(self, mode: str):
        g = self._gfx or {}
        if g.get("requested") == mode and not g.get("reboot_required"):
            self.win.flash(f"already in {MUX_SHORT.get(mode, mode)} mode")
            return
        answer = QMessageBox.warning(
            self, "Switch graphics mode",
            f"Switch the graphics mode to {core.MUX_LABELS[mode]}?\n\n"
            "This writes EC register 0x2e, the EC switch trigger and the "
            f"UEFI variable {core.MUX_VAR_NAME}.  It takes effect at the "
            "NEXT REBOOT — nothing changes in this session.\n\n"
            "On a laptop whose MUX was never reverse engineered this can "
            "leave the machine without a display, and recovery would then "
            "mean resetting the firmware.  The current value is saved to a "
            "backup first, and “Undo last switch” restores it.\n\n"
            "Switch now and reboot later?",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
        if answer == QMessageBox.Yes:
            self.win.send({"cmd": "graphics", "action": "set", "mode": mode},
                          tag="graphics")

    def _graphics_revert(self):
        backup = (self._gfx or {}).get("backup") or {}
        answer = QMessageBox.warning(
            self, "Undo graphics switch",
            "Restore the graphics mode saved before the last switch "
            f"({core.MUX_LABELS.get(backup.get('requested'), '?')})?\n\n"
            "As with the switch itself, this needs a reboot to take effect.",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
        if answer == QMessageBox.Yes:
            self.win.send({"cmd": "graphics", "action": "revert"},
                          tag="graphics")

    def refresh_graphics(self, st: dict):
        g = st.get("graphics") or {}
        self._gfx = g
        self.gfx_rows["running now"].setText(
            core.MUX_LABELS.get(g.get("effective")) or "unknown")
        pending = bool(g.get("reboot_required"))
        self.gfx_rows["at next boot"].setText(
            (core.MUX_LABELS.get(g.get("requested")) or "unknown")
            + ("  ·  reboot required" if pending else ""))

        online = self.win.online
        model_mux = core.feature("mux")
        enabled = bool(g.get("enabled")) and bool(online) and model_mux
        for mode, b in self.gfx_buttons.items():
            with QSignalBlockerSafe(b):
                b.setChecked(mode == g.get("requested"))
            b.setEnabled(enabled)
            b.setToolTip("" if enabled else
                         "no model definition for this laptop enables the "
                         "graphics switch" if not model_mux else
                         "the daemon is offline" if not online else
                         "set “AllowMuxSwitch”: true in the config to enable "
                         "this")
        has_backup = bool(g.get("backup"))
        self.gfx_revert.setEnabled(enabled and has_backup)
        self.gfx_revert.setToolTip(
            "Restore the value saved before the last switch" if has_backup
            else "nothing has been switched yet")

        # One status line, and it says the *reason* a control is dead rather
        # than leaving a greyed-out button to be interpreted.
        if not model_mux:
            note = ("no model definition for this laptop enables the graphics "
                    "switch — run `msi-control detect` and see CONTRIBUTING.md")
            style = notice_style(muted_color(self))
        elif not g.get("supported", True):
            note = ("✗ this firmware exposes neither the EC graphics bit nor "
                    f"the {core.MUX_VAR_NAME} variable — the switch is not "
                    "available here")
            style = notice_style(COL_CRIT, COL_CRIT)
        elif not g.get("enabled"):
            note = ("switching is disabled — set “AllowMuxSwitch”: true in "
                    f"{core.config_path()} and restart msi-controld")
            style = notice_style(muted_color(self))
        elif not online:
            note = "the daemon is offline, so nothing can be written"
            style = notice_style(muted_color(self))
        elif pending:
            note = "⚠ a reboot is required for the requested mode to apply"
            style = notice_style(COL_HOT, COL_HOT)
        else:
            note = ""
            style = ""
        self.gfx_warn.setText(note)
        self.gfx_warn.setStyleSheet(style)
        self.gfx_warn.setVisible(bool(note))

    def refresh(self, st: dict):
        cur = st.get("shift", {}).get("current")
        self._avail = st.get("shift", {}).get("available") or []
        for name, b in self.buttons.items():
            blocked = bool(self._avail) and name not in self._avail
            b.setEnabled(not blocked and bool(self.win.online))
            b.setToolTip("not supported by this EC firmware" if blocked else "")
            with QSignalBlockerSafe(b):
                b.setChecked(name == cur)
        on = st.get("cooler_boost") == "on"
        with QSignalBlockerSafe(self.boost_btn):
            self.boost_btn.setChecked(on)
        self.boost_btn.setEnabled(bool(self.win.online))
        self.boost_btn.setText("COOLER BOOST ON — tap to release"
                               if on else
                               "COOLER BOOST — hold both fans at 100%")
        # Only restyle when it is actually on.  "On" is the same filled accent
        # as every other selected control, so the tab has one meaning for one
        # look; the amber this used to wear read as "hot", which Cooler Boost
        # — the thing that *cools* — is the opposite of.
        if on:
            self.boost_btn.setStyleSheet(
                f"QPushButton{{background:{THEME['accent']};"
                f"color:{THEME['on_accent']};border:1px solid "
                f"{THEME['accent']}}}"
                f"QPushButton:hover{{background:{THEME['accent_hover']};"
                f"border-color:{THEME['accent_hover']}}}")
        else:
            self.boost_btn.setStyleSheet("")
        self.refresh_graphics(st)


class FansTab(QWidget):
    """Fan mode + the two editable curves.

    The curves carry **unsaved-change tracking**.  Without it the 1.5 s poll
    re-adopted the EC's curve on every refresh and silently reverted whatever
    the user had just dragged — the edit vanished mid-thought, and the Apply
    button then applied the EC's own value back to the EC.  A refresh may now
    only replace the editor when the editor holds no unsaved change, and the
    pending state clears by itself the moment the EC agrees (i.e. the write
    landed).  Nothing is written optimistically: the EC read-back is still the
    only thing that clears the flag.
    """

    def __init__(self, win, parent=None):
        super().__init__(parent)
        self.setObjectName("Page")
        self.win = win
        # Fan curves need this model's EC registers; without a model file they
        # are simply unknown, so the editor is refused rather than allowed to
        # write a guessed address.  Read once — the model cannot change while
        # the process lives.
        self.curve_ok = core.feature("fan_curve")
        lay = page_layout(self)

        self.curve_notice = QLabel("")
        self.curve_notice.setWordWrap(True)
        self.curve_notice.setVisible(False)
        if not self.curve_ok:
            self.curve_notice.setText(
                "This laptop has no model definition yet, so its fan-curve "
                "registers are unknown — the curve editor is read-only.  Fan "
                "mode, cooler boost and the charge limit still work, because "
                "the msi-ec driver provides those directly.  Run "
                "`msi-control detect` and see CONTRIBUTING.md → “Adding your "
                "model” to enable curves.")
            self.curve_notice.setStyleSheet(notice_style(COL_HOT, COL_HOT))
            self.curve_notice.setVisible(True)
        lay.addWidget(self.curve_notice)

        mode = Card("Fan mode")
        row = QHBoxLayout()
        row.setSpacing(SPACE)
        self.mode_btns = QButtonGroup(self)
        self.mode_btns.setExclusive(True)
        self.modes = {}
        for name in ("auto", "silent", "advanced"):
            b = QPushButton(name.capitalize())
            b.setCheckable(True)
            mark_checked(b)
            b.clicked.connect(lambda _=False, n=name: self.win.set_key("fan", n))
            self.mode_btns.addButton(b)
            self.modes[name] = b
            row.addWidget(b, 1)
        self.mode_now = QLabel("")
        self.mode_now.setFont(ui_font(TYPE_BODY))
        self.mode_now.setStyleSheet(f"color:{muted_color(self)}")
        row.addSpacing(SPACE)
        row.addWidget(self.mode_now, 0)
        mode.box.addLayout(row)
        mode.box.addWidget(hint_label(
            "EC fan modes.  “advanced” lets the fan follow the custom curve "
            "below; “silent” caps the speed; “auto” is the firmware default.  "
            + ("The curve editor is live — drag a point and Apply writes it."
               if self.curve_ok else
               "The curve below needs a model definition for this laptop."),
            mode))
        lay.addWidget(mode)

        self.canvases = {}
        self.spin_temps = {}
        self.spin_speeds = {}
        self.apply_btns = {}
        self.reset_btns = {}
        self.pending_labels = {}
        self.curve_state = {"cpu": None, "gpu": None}
        self._unsaved = {"cpu": False, "gpu": False}

        grids = QHBoxLayout()
        grids.setSpacing(PAGE_GAP)
        for which in ("cpu", "gpu"):
            card = Card(f"{which.upper()} fan curve")
            canvas = CurveCanvas(which)
            canvas.changed.connect(lambda w=which: self._canvas_changed(w))
            self.canvases[which] = canvas
            card.box.addWidget(canvas)

            trow = QGridLayout()
            trow.setHorizontalSpacing(4)
            trow.setVerticalSpacing(3)
            self.spin_temps[which] = []
            self.spin_speeds[which] = []
            for i in range(core.N_TEMPS):
                lab = QLabel(f"T{i + 1}")
                lab.setAlignment(Qt.AlignCenter)
                lab.setFont(ui_font(TYPE_MICRO))
                lab.setStyleSheet(f"color:{muted_color(self)}")
                sp = QSpinBox()
                sp.setRange(core.TEMP_MIN, core.TEMP_MAX)
                sp.setSuffix("°")
                sp.setFixedWidth(52)
                sp.setAccessibleName(f"{which.upper()} threshold {i + 1}")
                sp.valueChanged.connect(
                    lambda _v, w=which, kind="t": self._spin_changed(w, kind))
                self.spin_temps[which].append(sp)
                trow.addWidget(lab, 0, i)
                trow.addWidget(sp, 1, i)
            for i in range(core.N_SPEEDS):
                lab = QLabel(f"S{i}")
                lab.setAlignment(Qt.AlignCenter)
                lab.setFont(ui_font(TYPE_MICRO))
                lab.setStyleSheet(f"color:{muted_color(self)}")
                sp = QSpinBox()
                sp.setRange(core.SPEED_MIN, core.SPEED_MAX)
                sp.setSuffix("%")
                sp.setFixedWidth(48)
                sp.setAccessibleName(f"{which.upper()} speed {i}")
                sp.valueChanged.connect(
                    lambda _v, w=which, kind="s": self._spin_changed(w, kind))
                self.spin_speeds[which].append(sp)
                trow.addWidget(lab, 2, i)
                trow.addWidget(sp, 3, i)
            card.box.addLayout(trow)

            brow = QHBoxLayout()
            brow.setSpacing(SPACE)
            apply_btn = QPushButton(f"Apply {which.upper()} curve")
            apply_btn.setProperty("primary", True)
            apply_btn.setToolTip(
                "Write this curve into the embedded controller")
            apply_btn.clicked.connect(lambda _=False, w=which: self._apply(w))
            reset_btn = QPushButton("Load factory")
            reset_btn.setToolTip("Load the original firmware curve into the "
                                 "editor (nothing is written until you Apply)")
            reset_btn.clicked.connect(lambda _=False, w=which: self._load_ghost(w))
            pending = QLabel("● unsaved changes")
            pending.setVisible(False)
            pending.setFont(ui_font(TYPE_CAPTION, bold=True))
            pending.setStyleSheet(f"color:{COL_HOT}")
            self.apply_btns[which] = apply_btn
            self.reset_btns[which] = reset_btn
            self.pending_labels[which] = pending
            # One warning label per canvas, stored directly — the old code
            # kept a shared self.warn that ended up pointing at whichever
            # fan was built last.
            warn = QLabel("")
            warn.setWordWrap(True)
            warn.setVisible(False)
            setattr(self, f"warn_{which}", warn)
            brow.addWidget(apply_btn)
            brow.addWidget(reset_btn)
            brow.addSpacing(SPACE // 2)
            brow.addWidget(pending)
            brow.addStretch(1)
            card.box.addLayout(brow)
            card.box.addWidget(warn)
            grids.addWidget(card)
        lay.addLayout(grids)

        if not self.curve_ok:
            # Nothing here can be trusted without the model's registers, so
            # the whole editor goes read-only.  Fan *mode* above stays live:
            # that is a sysfs attribute the driver exposes on every machine
            # it binds to.
            for which in ("cpu", "gpu"):
                self.canvases[which].setEnabled(False)
                for sp in self.spin_temps[which] + self.spin_speeds[which]:
                    sp.setEnabled(False)
                self.apply_btns[which].setEnabled(False)
                self.reset_btns[which].setEnabled(False)

        lay.addStretch(1)

        self._syncing = False

    # -- editing ------------------------------------------------------------

    def _canvas_changed(self, which: str):
        if self._syncing:
            return
        st = self.curve_state[which]
        if not st:
            return
        st["temps"] = list(self.canvases[which].temps)
        st["speeds"] = list(self.canvases[which].speeds)
        self._unsaved[which] = True
        self._sync_spins(which)
        self._update_actions(which)

    def _spin_changed(self, which: str, kind: str):
        if self._syncing:
            return
        st = self.curve_state[which]
        if not st:
            return
        if kind == "t":
            st["temps"] = [sp.value() for sp in self.spin_temps[which]]
        else:
            st["speeds"] = [sp.value() for sp in self.spin_speeds[which]]
        self._unsaved[which] = True
        self.canvases[which].set_curve(st["temps"], st["speeds"])
        self._update_actions(which)

    def _sync_spins(self, which: str):
        st = self.curve_state[which]
        if not st:
            return
        self._syncing = True
        try:
            for sp, v in zip(self.spin_temps[which], st["temps"]):
                sp.blockSignals(True)
                sp.setValue(v)
                sp.blockSignals(False)
            for sp, v in zip(self.spin_speeds[which], st["speeds"]):
                sp.blockSignals(True)
                sp.setValue(v)
                sp.blockSignals(False)
        finally:
            self._syncing = False

    @staticmethod
    def _same_curve(a, b) -> bool:
        return bool(a) and bool(b) and a.get("temps") == b.get("temps") \
            and a.get("speeds") == b.get("speeds")

    def _check_valid(self, which: str) -> bool:
        st = self.curve_state[which] or {}
        warn = getattr(self, f"warn_{which}")
        try:
            core.check_curve(st.get("temps"), st.get("speeds"))
        except core.ValidationError as e:
            # Visible as well as coloured: colour alone fails for a
            # meaningful share of users, and an invisible warning is no
            # warning at all.  Text colour is derived from the badge
            # background rather than assumed white.
            warn.setText(f"✗ {e} — Apply is disabled until this is fixed")
            warn.setStyleSheet(notice_style(COL_CRIT, COL_CRIT))
            warn.setVisible(True)
            return False
        warn.setText("")
        warn.setVisible(False)
        return True

    def _update_actions(self, which: str):
        """Apply is live only for a valid, changed, online curve."""
        valid = self._check_valid(which)
        dirty = self._unsaved[which]
        online = bool(self.win.online)
        btn = self.apply_btns[which]
        btn.setEnabled(online and dirty and valid and self.curve_ok)
        if not self.curve_ok:
            btn.setToolTip("this laptop has no model definition for fan "
                           "curves")
        elif not online:
            btn.setToolTip("the daemon is offline, so nothing can be written")
        elif not dirty:
            btn.setToolTip("no changes — edit the curve or a spin box first")
        elif not valid:
            btn.setToolTip("the curve is not valid yet")
        else:
            btn.setToolTip("Write this curve into the embedded controller")
        self.reset_btns[which].setEnabled(
            self.curve_ok and self.canvases[which].ghost is not None)
        self.pending_labels[which].setVisible(dirty)

    def _apply(self, which: str):
        st = self.curve_state[which]
        if not self.curve_ok or not st or not self._check_valid(which):
            return
        self.win.send({"cmd": "curve", "which": which,
                       "temps": st["temps"], "speeds": st["speeds"]})

    def _load_ghost(self, which: str):
        g = self.canvases[which].ghost
        if not g:
            return
        st = self.curve_state.setdefault(which, {})
        st["temps"] = list(g["temps"])
        st["speeds"] = list(g["speeds"])
        self._unsaved[which] = True
        self.canvases[which].set_curve(st["temps"], st["speeds"])
        self._sync_spins(which)
        self._update_actions(which)

    # -- from the daemon ----------------------------------------------------

    def refresh_factory(self):
        """The daemon answered with the factory profile body: use its curves
        as the ghost drawn under the editable ones."""
        body = self.win.profile_cache.get("factory") or {}
        ghost = body.get("curve") or {}
        for which in ("cpu", "gpu"):
            g = ghost.get(which)
            if g:
                self.canvases[which].ghost = g
                self.canvases[which].update()

    def refresh(self, st: dict):
        cur = st.get("fan", {}).get("current")
        for name, b in self.modes.items():
            b.setEnabled(bool(self.win.online))
            with QSignalBlockerSafe(b):
                b.setChecked(name == cur)
        self.mode_now.setText(f"current: {cur}" if cur else "")

        factory = None
        saved = (st.get("profiles") or {}).get("saved") or []
        if "factory" in saved:
            factory = self.win.profile_cache.get("factory")

        curves = st.get("curve") or {}
        for which in ("cpu", "gpu"):
            live = st.get(which, {})
            self.canvases[which].set_live(
                (live.get("temp"), live.get("fan_pct")))
            if self.canvases[which].ghost is None and factory:
                g = (factory.get("curve") or {}).get(which)
                if g:
                    self.canvases[which].ghost = g
                    self.canvases[which].update()
            got = curves.get(which)
            if got:
                if self._unsaved[which]:
                    # The editor holds a change the EC has not got yet.  We
                    # may only clear the flag when the EC now *agrees* — that
                    # is the read-back confirming the write.
                    if self._same_curve(self.curve_state[which], got):
                        self._unsaved[which] = False
                elif not self._same_curve(self.curve_state[which], got):
                    # No unsaved change: follow the EC (first load, a profile
                    # apply, a re-apply, or another client moving it).
                    self.curve_state[which] = {"temps": list(got["temps"]),
                                               "speeds": list(got["speeds"])}
                    self._sync_spins(which)
                    self.canvases[which].set_curve(got["temps"], got["speeds"])
            self._update_actions(which)


class BatteryTab(QWidget):
    """Charge limit.

    The slider edits a *pending* value; nothing reaches the EC until
    Apply is pressed.  That distinction is spelled out on screen rather
    than implied, because the previous version wrote on slider release —
    so a slow drag across the track silently reprogrammed the charger
    several times on the way to wherever you were aiming.
    """

    def __init__(self, win, parent=None):
        super().__init__(parent)
        self.setObjectName("Page")
        self.win = win
        self._applied: int | None = None      # what the EC actually holds
        self._loaded = False                  # have we seen a status yet
        lay = page_layout(self)

        card = Card("Charge limit")
        self.label = QLabel("—")
        self.label.setFont(ui_font(TYPE_H1, bold=True))
        self.label.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)

        self.slider = QSlider(Qt.Horizontal)
        self.slider.setRange(core.CHARGE_MIN, core.CHARGE_MAX)
        self.slider.setSingleStep(1)
        self.slider.setPageStep(10)
        self.slider.setMinimumHeight(H_SLIDER)
        self.slider.setAccessibleName("Charge limit percentage")
        self.slider.setToolTip(
            "Choose where charging stops.  Nothing is written until you "
            "press Apply.")
        self.slider.valueChanged.connect(self._pending_changed)

        scale = QHBoxLayout()
        for text, align in (("20%", Qt.AlignLeft), ("60%", Qt.AlignHCenter),
                            ("100%", Qt.AlignRight)):
            s = QLabel(text)
            s.setFont(ui_font(TYPE_MICRO))
            s.setStyleSheet(f"color:{muted_color(self)}")
            s.setAlignment(align | Qt.AlignVCenter)
            scale.addWidget(s, 1)

        row = QHBoxLayout()
        row.setSpacing(SPACE)
        for pct in (60, 80, 100):
            b = QPushButton(f"{pct}%")
            b.setToolTip(f"Select {pct}% (still needs Apply)")
            b.clicked.connect(lambda _=False, p=pct: self._preset(p))
            row.addWidget(b)
        row.addStretch(1)

        # Apply is the whole point of this tab, so it is a real button with
        # a real state: disabled when there is nothing to apply.
        self.apply_btn = QPushButton("Apply")
        self.apply_btn.setProperty("primary", True)
        self.apply_btn.setToolTip("Write the selected limit to the battery")
        self.apply_btn.clicked.connect(self._apply)
        self.revert_btn = QPushButton("Revert")
        self.revert_btn.setToolTip("Discard the pending change")
        self.revert_btn.clicked.connect(self._revert)
        row.addWidget(self.revert_btn)
        row.addWidget(self.apply_btn)

        # "60% applied · 80% pending" — the difference between the slider
        # and the hardware, stated rather than guessed.
        self.pending_label = QLabel("")
        self.pending_label.setWordWrap(True)
        self.pending_label.setFont(ui_font(TYPE_BODY, bold=True))
        self.pending_label.setVisible(False)

        self.detail = QLabel("")
        self.detail.setWordWrap(True)
        self.detail.setFont(ui_font(TYPE_BODY))
        self.detail.setStyleSheet(f"color:{muted_color(self)}")

        card.box.addWidget(self.label)
        card.box.addWidget(self.slider)
        card.box.addLayout(scale)
        card.box.addLayout(row)
        card.box.addWidget(self.pending_label)
        card.box.addWidget(self.detail)
        card.box.addWidget(hint_label(
            "Charging stops at the limit and resumes when the battery dips "
            "about 10% below it — keeping a laptop at 60–80% is the single "
            "biggest thing you can do for long-term battery health.  "
            "Choose a value, then press Apply.", card))
        lay.addWidget(card)

        info = Card("Battery")
        self.info = QLabel("—")
        self.info.setWordWrap(True)
        self.info.setFont(ui_font(TYPE_BODY))
        info.box.addWidget(self.info)
        lay.addWidget(info)
        lay.addStretch(1)
        self._sync_pending()

    # -- pending vs applied -------------------------------------------------

    def _dirty(self) -> bool:
        """Is the slider showing something the EC is not holding?

        An unreadable threshold (`_applied is None`) counts as *dirty*, not
        as "nothing to do".  The driver returns -ENODATA when the charge byte
        reads 0, which is this machine's genuine unset boot state — so the
        old `is not None` guard left Apply permanently disabled on a fresh
        boot, in precisely the situation where the limit most needs setting.
        """
        if not self._loaded:
            return False
        if self._applied is None:
            return True
        return self.slider.value() != self._applied

    def _pending_changed(self, _value: int):
        self._sync_pending()

    def _sync_pending(self):
        """Keep the Apply/Revert buttons and the status line honest."""
        val = self.slider.value()
        dirty = self._dirty()
        online = bool(self.win.online)

        self.apply_btn.setEnabled(online and dirty)
        self.revert_btn.setEnabled(online and dirty)
        self.slider.setEnabled(online)
        # Name the concrete value in the button: "Apply 80%" tells you what
        # will happen, "Apply" leaves you checking the slider first.  With
        # nothing pending it reads as the disabled state it is.
        self.apply_btn.setText(f"Apply {val}%" if dirty else "Apply")
        # The buttons must not be the only thing telling you it is unsafe to
        # press Apply — say why when they are off.
        self.apply_btn.setToolTip(
            f"Write {val}% to the battery charge threshold" if (online and dirty)
            else "Nothing pending — move the slider first" if online else
            "The daemon is not running, so nothing can be written")

        if not self._loaded:
            self.pending_label.setVisible(False)
        elif self._applied is None:
            self.pending_label.setText("The battery threshold is not readable")
            self.pending_label.setStyleSheet(f"color:{COL_WARM}")
            self.pending_label.setVisible(True)
        elif dirty:
            self.pending_label.setText(
                f"{self._applied}% applied  ·  {val}% pending")
            self.pending_label.setStyleSheet(f"color:{THEME['accent']}")
            self.pending_label.setVisible(True)
        else:
            self.pending_label.setText(f"{val}% applied — no pending change")
            self.pending_label.setStyleSheet(f"color:{muted_color(self)}")
            self.pending_label.setVisible(True)

    # -- actions -------------------------------------------------------------

    def _apply(self):
        value = self.slider.value()
        # Send the tag so the reply handler can name the setting in the
        # confirmation instead of printing a bare "applied".
        self.win.send({"cmd": "set", "key": "charge_end", "value": value},
                      tag="set:charge_end")

    def _revert(self):
        # Reset to whatever the EC is holding; if the threshold is not
        # readable there is nothing to go back to, so fall back to the same
        # value refresh() adopts rather than leaving a dead button.
        target = self._applied if self._applied is not None else core.CHARGE_MAX
        with QSignalBlockerSafe(self.slider):
            self.slider.setValue(target)
        self._sync_pending()

    def _preset(self, pct: int):
        """Select a preset — deliberately does NOT apply it."""
        self.slider.setValue(pct)
        self._sync_pending()

    # -- from the daemon ----------------------------------------------------

    def refresh(self, st: dict):
        bat = st.get("battery") or {}
        end = bat.get("charge_end")

        # Decide whether to adopt BEFORE updating _applied: once we do,
        # "the slider is behind the EC" is no longer observable.
        had_pending = self._dirty()
        slider_held = self.slider.isSliderDown()

        self._applied = end
        self._loaded = True

        # Adopt the EC's value, unless the user is mid-drag or still has an
        # unapplied choice on screen — yanking the slider out from under
        # them is how a user ends up applying a value they did not pick.
        if not slider_held and not had_pending:
            with QSignalBlockerSafe(self.slider):
                self.slider.setValue(end if end is not None
                                     else core.CHARGE_MAX)

        self.label.setText(f"stop charging at {end}%" if end is not None
                           else "charge limit not readable")
        start = bat.get("charge_start")
        self.detail.setText(f"recharges from {start}%"
                            if start is not None else "")
        self.info.setText(self._battery_line(bat))
        self._sync_pending()

    @staticmethod
    def _battery_line(bat: dict) -> str:
        bits = []
        if bat.get("pct") is not None:
            bits.append(f"charge {bat['pct']}%")
        if bat.get("status"):
            bits.append(bat["status"])
        if bat.get("energy_full") and bat.get("energy_full_design"):
            wear = bat["energy_full"] / bat["energy_full_design"]
            bits.append(f"health ≈ {wear:.0%} of design")
        return " · ".join(bits) or "no battery data"


class ProfilesTab(QWidget):
    def __init__(self, win, parent=None):
        super().__init__(parent)
        self.setObjectName("Page")
        self.win = win
        lay = QHBoxLayout(self)
        lay.setContentsMargins(PAGE_PAD, PAGE_PAD_V, PAGE_PAD, PAGE_PAD_V)
        lay.setSpacing(PAGE_GAP)

        left = Card("Profiles")
        self.listw = QListWidget()
        self.listw.setMinimumHeight(240)
        self.listw.itemDoubleClicked.connect(lambda _i: self._apply())
        left.box.addWidget(self.listw, 1)
        self.apply_btn = QPushButton("Apply selected")
        self.apply_btn.setProperty("primary", True)
        self.apply_btn.clicked.connect(self._apply)
        left.box.addWidget(self.apply_btn)
        left.box.addWidget(hint_label(
            "Double-click a profile to apply it.  “factory” restores exactly "
            "what this laptop shipped with.", left))
        lay.addWidget(left, 1)

        right = Card("Save / delete")
        self.name = QLineEdit()
        self.name.setPlaceholderText("e.g. quiet-office")
        self.name.returnPressed.connect(self._save)
        right.box.addWidget(field_label("Name"))
        right.box.addWidget(self.name)
        b1 = QPushButton("Save current settings as…")
        b1.setProperty("primary", True)
        b1.clicked.connect(self._save)
        b2 = QPushButton("Delete selected")
        b2.setProperty("danger", True)
        b2.clicked.connect(self._delete)
        self.save_btn = b1
        self.delete_btn = b2
        # The buttons belong directly under the field they act on.  Without
        # the stretch, the form row absorbs the card's extra height and the
        # two buttons drift down into the middle of the card, leaving a void
        # above them that reads as a layout bug.
        right.box.addWidget(b1)
        right.box.addWidget(b2)
        right.box.addStretch(1)
        right.box.addWidget(hint_label(
            "A profile stores performance mode, fan mode, cooler boost and "
            "both fan curves.  “factory” is captured from "
            "the EC on first start — apply it to return to exactly what the "
            "laptop shipped with.\n\n"
            "Applying one does not touch your charge limit — that is a "
            "battery choice, not a performance one.  Only the “battery” "
            "profile sets it (to 60%).", right))
        # Top-aligned so the card is only as tall as its contents: letting it
        # stretch to match the (tall) profile list left a large void under the
        # two buttons that reads as a broken layout.
        lay.addWidget(right, 1, Qt.AlignTop)
        self._names: list = []

    def _selected(self) -> str | None:
        item = self.listw.currentItem()
        if item is None:
            return None
        name = item.data(Qt.ItemDataRole.UserRole)
        return name if name in self._names else None

    def _apply(self):
        name = self._selected()
        if not name:
            self.win.flash("select a profile first", ok=False)
            return
        self.win.send({"cmd": "profile", "action": "apply", "name": name},
                      tag="profile:apply")

    def _save(self):
        name = self.name.text().strip()
        try:
            core.check_profile_name(name)
        except core.ValidationError as e:
            self.win.flash(str(e), ok=False)
            return
        self.win.send({"cmd": "profile", "action": "save-current",
                       "name": name}, tag="profile:save")

    def _delete(self):
        name = self._selected()
        if not name:
            self.win.flash("select a profile first", ok=False)
            return
        # Deleting is the one irreversible action in this tab, so it asks.
        # Everything else here is a setting the EC can simply be told again.
        if name == "factory":
            self.win.flash("the factory profile cannot be deleted", ok=False)
            return
        answer = QMessageBox.question(
            self, "Delete profile",
            f"Delete the profile “{name}”?  This cannot be undone.",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
        if answer == QMessageBox.Yes:
            self.win.send({"cmd": "profile", "action": "delete", "name": name},
                          tag="profile:delete")

    def refresh(self, st: dict):
        profs = st.get("profiles") or {}
        builtin = profs.get("builtin") or []
        saved = profs.get("saved") or []
        self._names = builtin + saved

        # Rebuild only when the set actually changed, so a 1.5 s poll does
        # not reset the user's selection out from under them.
        seen = [self.listw.item(i).data(Qt.ItemDataRole.UserRole)
                for i in range(self.listw.count())]
        if seen != self._names:
            keep = self._selected()
            self.listw.clear()
            for n in builtin:
                it = QListWidgetItem(f"{n}  ·  built-in")
                it.setData(Qt.ItemDataRole.UserRole, n)
                it.setToolTip("shipped with the daemon — delete is refused")
                self.listw.addItem(it)
            for n in saved:
                it = QListWidgetItem(f"{n}  ·  saved")
                it.setData(Qt.ItemDataRole.UserRole, n)
                it.setToolTip("saved on this machine")
                self.listw.addItem(it)
            if keep in self._names:
                for i in range(self.listw.count()):
                    if self.listw.item(i).data(Qt.ItemDataRole.UserRole) == keep:
                        self.listw.setCurrentRow(i)
                        break
        self.apply_btn.setEnabled(bool(self.win.online))
        # Save and delete are daemon writes too, so they follow the same rule
        # the rest of the app uses: with the daemon down nothing is writable.
        # Leaving them live only produced a "✗" on click, which reads as a
        # bug rather than the offline state the banner already explains.
        self.save_btn.setEnabled(bool(self.win.online))
        self.delete_btn.setEnabled(bool(self.win.online))


