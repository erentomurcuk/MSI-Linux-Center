        cur = od.get("on")
        if cur is None:
            print("display overdrive: ? "
                  + dim("(register unreachable)"))
        else:
            print(f"display overdrive: {'on' if cur else 'off'}")
        return
    if not core.feature("display_overdrive"):
        die("this laptop's model file has no proven display overdrive "
            "register; flipping an unproven bit is exactly the kind of "
            "write this program refuses")
    try:
        out = core.call({"cmd": "overdrive", "action": "set",
                         "on": args.value == "on"}, timeout=args.timeout)
    except OSError as e:
        die(f"{e}\n{need_daemon_hint()}")
    except (ProtocolError, ValidationError) as e:
        die(str(e))
    if args.json:
        print(json.dumps(out, indent=2, sort_keys=True))
        return
    print(green("✓ ") + out.get("summary", "set"))


def _device_cmd(args, key, label):
    """Show or set one of the driver's device attributes (webcam, keys).

    These are msi-ec sysfs attributes, not model registers: the driver
    creates each one only on firmware that has the feature, so a missing
    attribute is the firmware's own "not available", and the daemon
    writes them through the same validated, read-back path as any other
    setting.
    """
    if args.value is None:
        st = status(args)
        cur = st.get(key)
        if cur is None:
            die(f"this firmware exposes no {label} attribute; the msi-ec "
                "driver creates it only when the feature exists")
        if args.json:
            print(json.dumps({key: cur}, indent=2))
            return
        print(cur)
        return
    _set(args, key, args.value)


def cmd_webcam(args):
    """The built-in camera's power, at the EC level (reversible)."""
    _device_cmd(args, "webcam", "webcam")


def cmd_super_battery(args):
    """MSI's lowest-power mode (only some firmwares have it)."""
    _device_cmd(args, "super_battery", "super battery")


def cmd_fn_key(args):
    """Which side the Fn key sits on (left is the factory layout)."""
    _device_cmd(args, "fn_key", "fn key")


def cmd_win_key(args):
