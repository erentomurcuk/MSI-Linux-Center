def cmd_selftest(args):
    """verify.sh as one command: reversible round-trips on the real EC."""
    if not args.yes:
        die("the self-test briefly writes real modes, a real charge limit "
            "and\n  the real curves to your EC, verifying each by reading "
            "it back, and\n  restores everything it found.  Re-run with "
            "--yes once you have read\n  this.  It is the same check "
            "verify.sh performs, minus the process\n  startups.")
    try:
        # A walk over every mode can legitimately outlive the 5 s a terse
        # command needs, so the floor here is generous, not the default.
        out = core.call({"cmd": "selftest"}, timeout=max(args.timeout, 30.0))
    except (OSError, ProtocolError) as e:
        die(f"{e}\n{need_daemon_hint()}")
    if args.json:
        print(json.dumps(out, indent=2, sort_keys=True))
        return
    if args.pr:
        print(out.get("markdown", ""))
        return
    section = None
    failed = 0
    for r in out.get("results") or []:
        if r.get("section") != section:
            section = r.get("section")
            print(bold(f"\n{section}"))
        mark = green("✓ ") if r.get("ok") else red("✗ ")
        detail = f": {r['detail']}" if r.get("detail") else ""
        print(f"  {mark}{r.get('name', '?')}{detail}")
        failed += 0 if r.get("ok") else 1
    total = len(out.get("results") or [])
    print()
    if failed or not out.get("ok"):
        print(red(f"SELF-TEST FAILED: {failed} of {total} checks"))
        return 1
    print(green(f"ALL {total} CHECKS PASSED"))
    print(dim("  everything was restored; paste-ready report: "
              "msi-control selftest --yes --pr"))
    return 0


def cmd_wait(args):
    """Block until the daemon answers; handy in scripts/units."""
    deadline = time.time() + args.seconds
    while time.time() < deadline:
        if core.daemon_available():
            print("ready")
            return 0
        time.sleep(0.3)
    print("timed out", file=sys.stderr)
    return 1


def _freq_show(args):
    """Frequency facts, locally when possible: they are world-readable."""
    facts = core.cpufreq_facts()
    if not facts.get("present") and not args.direct:
        # The daemon might see a cpufreq the unprivileged caller cannot;
        # unlikely, but asking costs one round trip.
        try:
            facts = core.call({"cmd": "freq"}, timeout=args.timeout)
        except (OSError, ProtocolError):
            pass
    if not facts.get("present"):
        if args.json:
            print(json.dumps({"present": False}, indent=2))
        else:
            die("cpufreq is unavailable (no /sys/.../cpufreq policies; "
                "is this a CPU without frequency scaling?)")
        return
    if args.json:
        print(json.dumps(facts, indent=2))
        return
    print(bold("CPU frequency (all cores)"))
    print(f"  max       {core.khz_to_ghz(facts.get('max_khz'))} GHz"
          + ("" if facts.get("max_khz") else dim("  (differs per core)")))
    if facts.get("max_khz") is None:
        uniq = sorted({v for v in facts.get("max_khz_list") or []})
        print("  per core  " + ", ".join(core.khz_to_ghz(v) for v in uniq)
              + " GHz")
    print(f"  hardware range  {core.khz_to_ghz(facts.get('cpuinfo_min_khz'))}"
          f"..{core.khz_to_ghz(facts.get('cpuinfo_max_khz'))} GHz")
    print(dim(f"  {facts.get('policies')} policies; values reset at reboot"))


def cmd_freq(args):
    if args.max is None:
        _freq_show(args)
        return
    # Accept "3.5" or "3500" as GHz, a plain kHz count as itself: the
    # classic reading mistake (one zeroes too few) would pin the CPU to
    # its floor, so anything small is GHz and huge values get one check.
    try:
        number = float(args.max)
    except ValueError:
        die(f"max frequency: {args.max!r} is not a number "
            "(use GHz like 3.5, or kHz like 3500000)")
    khz = int(number * 1_000_000) if number < 100000 else int(number)
    facts = core.cpufreq_facts()
    if facts.get("present"):
        # The same bounds the daemon will apply, so an out-of-range value
        # dies here with a clear message instead of a daemon round trip.
        core.check_freq_khz(khz, facts["cpuinfo_min_khz"],
                            facts["cpuinfo_max_khz"], "max frequency")
    try:
        out = core.call({"cmd": "freq", "action": "set", "max_khz": khz},
                        timeout=args.timeout)
    except OSError as e:
        die(f"{e}\n{need_daemon_hint()}")
    except (ProtocolError, ValidationError) as e:
        die(str(e))
    if args.json:
        print(json.dumps(out, indent=2, sort_keys=True))
        return
    print(green("✓ ") + out.get("summary", "max frequency set"))
    print(dim("  resets at reboot; per-core values clear individually"))


def cmd_undervolt(args):
    """Read the OC mailbox, or write offsets to it (AllowUndervolt)."""
    if args.action == "show":
        out = None
        if not args.direct:
            try:
                out = core.call({"cmd": "undervolt"}, timeout=args.timeout)
            except (OSError, ProtocolError) as e:
                if args.json:
                    print(json.dumps({"planes": None, "allowed": None,
                                      "error": str(e)}, indent=2))
                else:
                    die(f"{e}\n{need_daemon_hint()}")
                return
        planes = (out or {}).get("planes")
        allowed = (out or {}).get("allowed")
        if planes is None:
            if args.json:
                print(json.dumps({"planes": None, "allowed": allowed},
                                 indent=2))
            else:
                die("no MSR devices (/dev/cpu/*/msr): undervolting is "
                    "unavailable in this kernel")
            return
        if args.json:
            print(json.dumps({"planes": planes, "allowed": allowed},
                             indent=2))
            return
        print(bold("Voltage offsets (volatile; cleared by reboot and sleep)"))
        for plane, _idx in core.UV_PLANES:
            mv = planes.get(plane)
            print(f"  {plane:<9} " + (f"{mv} mV" if mv is not None
                                     else dim("?")))
        if not allowed:
            print(yellow("undervolting is NOT enabled in the config: set "
                         "AllowUndervolt to write offsets"))
        else:
            print(dim("write with: msi-control undervolt set core=-80 "
                      "cache=-60"))
        return

    if args.action != "set" and args.action != "reset":
        raise ValidationError(f"unknown undervolt action {args.action!r}")
    if args.action == "reset":
        out = core.call({"cmd": "undervolt", "action": "reset"},
                        timeout=args.timeout)
        if args.json:
            print(json.dumps(out, indent=2, sort_keys=True))
        else:
            print(green("✓ ") + out["summary"])
            print(dim("  " + out.get("volatile", "")))
        return

    if not args.values:
        raise ValidationError("undervolt set needs at least one "
                              "plane=mV pair (e.g. core=-80 cache=-60)")
    values = {}
    for item in args.values:
        try:
            plane, mv = item.split("=", 1)
        except ValueError:
            raise ValidationError(f"{item!r} is not plane=mV "
                                  "(core=-80, cache=-60, gpu=0, ...)")
        plane = plane.strip().lower()
        try:
            mv = int(mv)
        except ValueError:
            raise ValidationError(f"{item!r}: {mv!r} is not an integer mV")
        values[core.check_uv_plane(plane)] = core.check_uv_mv(mv)
    if not args.yes:
        die("refusing to change CPU voltages without --yes.\n"
            "  A too-deep offset freezes the machine *now*; the values hold\n"
            "  until the next reboot or suspend, which is the recovery.  A\n"
            "  locked BIOS ignores them, so the daemon verifies every write\n"
            "  and reports a refusal.  Re-run as `msi-control undervolt set "
            + " ".join(f"{k}={v}" for k, v in values.items())
            + " --yes`\n  once you have read the Undervolting section of "
            "README.md.")
    try:
        # The socket verb is "apply"; the subcommand keeps only its
        # user-facing "set" name, and speaking a verb the daemon does not
        # know used to turn every undervolt write into a refusal.
        out = core.call({"cmd": "undervolt", "action": "apply",
                         "values": values}, timeout=args.timeout)
    except OSError as e:
        die(f"{e}\n{need_daemon_hint()}")
    except (ProtocolError, ValidationError) as e:
        die(str(e))
    if args.json:
        print(json.dumps(out, indent=2, sort_keys=True))
        return
    print(green("✓ applied"))
    for plane, mv in out["applied"].items():
        if mv:
            print(f"  {plane:<9} {mv} mV")
    print(dim("  " + out.get("volatile", "")))


def cmd_overdrive(args):
    """Panel overdrive: the Dragon Center toggle, one EC bit (model-gated)."""
    if args.value is None:
        st = status(args)
        od = st.get("overdrive") or {}
        if args.json:
            print(json.dumps(od, indent=2))
            return
        if not od.get("supported"):
            print(dim("display overdrive: no proven register for this "
                      "laptop's model file"))
