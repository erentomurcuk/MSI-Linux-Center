#!/usr/bin/env python3
"""msi-control, command line control for MSI laptops running Linux.

Reads work without the daemon (plain sysfs); anything that changes a setting
needs msi-controld running as root.

Examples:
    msi-control status                 # full state (daemon) or degraded view
    msi-control mode                   # show performance mode
    msi-control mode sport             # eco | comfort | sport | turbo
    msi-control fan advanced           # auto | silent | advanced
    msi-control boost on               # Cooler Boost
    msi-control battery 80             # stop charging at 80 %
    msi-control curve show
    msi-control curve cpu --temps 55,60,65,70,78,85 --speeds 0,40,55,65,75,85,100
    msi-control profile list
    msi-control profile apply gaming
    msi-control profile save quiet-office
    msi-control graphics               # graphics mode (MUX): hybrid | discrete
    msi-control monitor                # live temperature / fan view
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time


def _add_lib_path() -> str:
    """Find msi_control.py, whether run from the source tree or installed.

    Installed layout puts the shared module in /usr/local/lib/msi-control
    while the wrappers live in /usr/local/bin, so dirname(__file__) alone
    is not enough, and the CLI would die with ModuleNotFoundError.
    """
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [here,
                  os.path.join(here, "..", "lib", "msi-control"),
                  "/usr/local/lib/msi-control",
                  "/usr/lib/msi-control"]
    for c in candidates:
        if os.path.isfile(os.path.join(c, "msi_control.py")):
            c = os.path.realpath(c)
            if c not in sys.path:
                sys.path.insert(0, c)
            return c
    sys.path.insert(0, here)
    return here


_add_lib_path()

import msi_control as core                                     # noqa: E402
from msi_control import ProtocolError, ValidationError        # noqa: E402
from msi_control import (BAND_COOL, BAND_CRIT, BAND_HOT,      # noqa: E402
                         BAND_WARM)


# --------------------------------------------------------------------------
# output helpers
# --------------------------------------------------------------------------

TTY = sys.stdout.isatty()

def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if TTY else str(text)

def bold(t):   return _c("1", t)
def dim(t):    return _c("2", t)
def green(t):  return _c("32", t)
def yellow(t): return _c("33", t)
def red(t):    return _c("31", t)
def cyan(t):   return _c("36", t)


def die(msg: str, code: int = 1):
    print(red(f"error: {msg}"), file=sys.stderr)
    sys.exit(code)


def need_daemon_hint() -> str:
    return ("msi-controld is not running; start it with\n"
            "    sudo systemctl start msi-controld\n"
            "(settings can only be changed by the privileged daemon)")


def status(args) -> dict:
    """Full status via daemon; fall back to a degraded local view."""
    if args.direct:
        return core.local_status()
    try:
        st = core.call({"cmd": "status"}, timeout=args.timeout)
        st["partial"] = False
        return st
    except (OSError, ProtocolError) as e:
        st = core.local_status()
        st["_daemon_error"] = str(e)
        return st


def print_status(st: dict, as_json: bool = False):
    if as_json:
        print(json.dumps(st, indent=2, sort_keys=True))
        return

    drv = st.get("driver", {})
    if not drv.get("present"):
        print(red("msi-ec driver is not loaded: fan/mode control unavailable"))
        print(dim("  sudo modprobe msi-ec        (or check install.sh)"))
    else:
        fw = drv.get("fw") or "?"
        date = drv.get("fw_date") or ""
        dbg = green("debug=1") if drv.get("debug") else red("debug=0")
        print(f"{bold('EC')}  {fw}  {dim(date)}  {dbg}")

    model = st.get("model")
    if model:
        if model.get("supported"):
            print(f"{bold('Model')} {cyan(model.get('name') or '?')} "
                  f"{dim('(' + str(model.get('id')) + ')')}")
        else:
            print(f"{bold('Model')} {yellow('unsupported')}  "
                  f"{dim('no model file matches this laptop: fan curve, '
                        'RPM and graphics switch are off')}")
            print(dim("      run `msi-control detect` and see CONTRIBUTING.md"))

    if st.get("partial"):
        print(yellow("offline view: daemon not running, no RPM/fan-curve"))
        if st.get("_daemon_error"):
            print(dim(f"  ({st['_daemon_error']})"))

    shift = st.get("shift", {})
    fan = st.get("fan", {})
    print(f"{bold('Mode')}   {cyan(shift.get('current') or '?'):<9} "
          f"{dim('available: ' + ', '.join(shift.get('available') or []))}")
    print(f"{bold('Fan')}    {cyan(fan.get('current') or '?'):<9} "
          f"{dim('available: ' + ', '.join(fan.get('available') or []))}")
    cb = st.get("cooler_boost")
    cb_txt = {"on": red("ON"), "off": dim("off")}.get(cb, dim("n/a"))
    print(f"{bold('Boost')}  {cb_txt}")

    # The driver's optional device attributes: present only on firmware
    # that has them, so the line appears only when there is something to
    # say (an absent attribute is not "off", it is "not built in").
    misc = []
    for key, label in (("webcam", "webcam"),
                       ("super_battery", "super battery"),
                       ("fn_key", "fn"), ("win_key", "win")):
        v = st.get(key)
        if v is not None:
            misc.append(f"{label} {v}")
    if misc:
        print(f"{bold('Misc')}    {dim(' · '.join(misc))}")

    for which in ("cpu", "gpu"):
        s = st.get(which, {})
        temp = s.get("temp")
        pct = s.get("fan_pct")
        rpm = s.get("rpm")
        # Same bands as the GUI (core.temp_band), one definition, so a
        # colour means the same thing in both front-ends.
        temp_s = "??" if temp is None else f"{temp}°C"
        band = core.temp_band(temp)
        temp_s = {BAND_COOL: green, BAND_WARM: yellow,
                  BAND_HOT: red, BAND_CRIT: red}.get(band, dim)(temp_s)
        line = f"{bold(which.upper()):<6}{temp_s:<8}"
        line += f"fan {('??' if pct is None else str(pct) + '%'):>4}"
        line += f"  {dim(str(rpm) + ' RPM') if rpm is not None else dim('RPM n/a')}"
        # The GPU's own clock rides on its row.  The merge tries NVML
        # first because on a hybrid machine the kernel's reading is the
        # iGPU's while NVML names the discrete card; the NVIDIA
        # proprietary driver publishes nothing in sysfs at all.
        if which == "gpu":
            g = core.gpu_clock_with_nvml(
                (st.get("sys") or {}).get("gpu"))
            if g and g.get("mhz"):
                line += f"  {cyan(str(g['mhz']) + ' MHz')}"
        print(line)

    # The machine-wide readings (kernel interfaces, present with the
    # daemon down too, so they print from either status path).
    sysf = st.get("sys") or {}
    # The cap is world-readable as well; the offline payload simply does
    # not carry a `freq` block, so read the same facts the daemon would.
    freq = st.get("freq")
    if not freq:
        freq = core.cpufreq_facts()
    cur = sysf.get("cpu_cur_khz")
    if cur:
        cap = freq.get("max_khz")
        print(f"{bold('Freq')}   running at "
              f"{cyan(core.khz_to_ghz(cur))} GHz"
              + (dim(f", capped at {core.khz_to_ghz(cap)} GHz")
                 if cap else ""))
    mem = sysf.get("mem")
    if mem and mem.get("total_kib"):
        gib = 1_048_576.0
        used = mem["used_kib"] / gib
        total = mem["total_kib"] / gib
        pct = mem.get("used_pct") or 0.0
        print(f"{bold('Mem')}    {cyan(f'{used:.1f}')} of "
              f"{cyan(f'{total:.1f}')} GiB in use  "
              f"{dim('(' + f'{pct:.0f}' + '%)')}")
    # Busy% needs two samples of /proc/stat, so only the daemon (a
    # process that stays alive between polls) can report it; the load
    # average is a kernel-maintained window and needs no state.
    busy = sysf.get("cpu_busy_pct")
    loadavg = sysf.get("loadavg")
    if busy is not None or loadavg is not None:
        parts = []
        if busy is not None:
            parts.append(f"CPU {cyan(f'{busy:.0f}%')} busy")
        if loadavg is not None:
            parts.append(dim(f"1-min load {loadavg:.2f}"))
        print(f"{bold('Load')}   " + "  ".join(parts))

    bat = st.get("battery")
    if not bat:
        print(f"{bold('Batt')}   {dim('no battery found')}")
    else:
        pct = bat.get("pct")
        ac = bat.get("ac_online")
        ac_s = "AC" if ac else ("battery" if ac is False else "?")
        bar_len = 20
        filled = 0 if pct is None else round(pct * bar_len / 100)
        bar = green("█" * filled) + dim("░" * (bar_len-filled))
        # Health (capacity now over capacity when new) through whichever
        # pair this firmware publishes, energy_* or charge_*; both spell
        # the same ratio in different units.
        wear = (bat["full"] / bat["full_design"]
                if bat.get("full") and bat.get("full_design") else None)
        print(f"{bold('Batt')}   {bar} {pct if pct is not None else '?'}%  {dim(ac_s)}  "
              f"{dim(bat.get('status') or '')}"
              + (f"  {dim(f'health {wear:.0%}')}" if wear else ""))
        cs, ce = bat.get("charge_start"), bat.get("charge_end")
        if ce is not None:
            print(f"{bold('Limit')}  stop at {cyan(str(ce) + '%')}"
                  + (f", start at {cyan(str(cs) + '%')}" if cs is not None else "")
                  + dim("  (battery health / charge threshold)"))

    curve = st.get("curve")
    if curve:
        for which in ("cpu", "gpu"):
            c = curve.get(which)
            if not c:
                continue
            pts = ",".join(f"{t}:{s}" for t, s in zip(c["temps"], c["speeds"][1:]))
            print(f"{bold('Curve ' + which.upper())} base {c['speeds'][0]}%  "
                  f"{dim(pts + '  (%)')}")

    g = st.get("graphics")
    if g:
        eff = core.MUX_LABELS.get(g.get("effective"), "unknown")
        req = g.get("requested")
        line = f"{bold('Gfx')}    {cyan(eff)}"
        if g.get("reboot_required"):
            line += yellow(f"  -> {core.MUX_LABELS.get(req, req)} after reboot")
        elif req and req != g.get("effective"):
            line += dim(f"  (requested {req})")
        print(line)


def cmd_status(args):
    st = status(args)
    print_status(st, as_json=args.json)


def cmd_detect(args):
    """What this laptop is, and what a model file for it would need.

    Works with no root and with the daemon down, the moment somebody
    wondering "is my laptop supported?" is most likely to run it.
    """
    if args.write:
        try:
            path = core.write_draft(args.write)
        except core.ModelError as e:
            die(str(e))
        print(green("wrote ") + path)
        print(dim("  fill in the \"ec\" block, then follow CONTRIBUTING.md → "
                  "\"Adding your model\""))
        return
    report = core.detect(include_dump=args.ec_dump)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
        return
    print(core.render_detect(report))
    if not args.ec_dump:
        print()
        print(dim("add --ec-dump to include the 256-register EC map "
                  "(needs msi-ec debug=1)"))



def cmd_monitor(args):
    # Client-side busy% accounting: a monitor run stays alive between
    # ticks, so it can take two /proc/stat samples itself when the
    # daemon's own delta (over its poll window) is not in the payload.
    prev_times = core.read_cpu_times()
    try:
        while True:
            st = status(args)
            if args.json:
                print(json.dumps(st))
            else:
                cpu, gpu = st.get("cpu", {}), st.get("gpu", {})
                bat = st.get("battery") or {}
                shift = (st.get("shift") or {}).get("current") or "?"
                fan = (st.get("fan") or {}).get("current") or "?"
                line = (f"CPU {cpu.get('temp')}°C {cpu.get('fan_pct')}% "
                        f"{cpu.get('rpm') or '?'}rpm | "
                        f"GPU {gpu.get('temp')}°C {gpu.get('fan_pct')}% "
                        f"{gpu.get('rpm') or '?'}rpm | "
                        f"{shift}/{fan} | bat {bat.get('pct')}%")
                # The same machine-wide readings the Dashboard shows, on
                # the one line this view has: they are kernel facts, so
                # they are present with the daemon down too.
                sysf = st.get("sys") or {}
                cur = sysf.get("cpu_cur_khz")
                mem = sysf.get("mem") or {}
                extras = []
                if cur:
                    extras.append(f"cpu {core.khz_to_ghz(cur)}GHz")
                if mem.get("used_pct") is not None:
                    extras.append(f"ram {mem['used_pct']:.0f}%")
                busy = sysf.get("cpu_busy_pct")
                now_times = core.read_cpu_times()
                if busy is None:
                    busy = core.cpu_busy_pct(prev_times, now_times)
                prev_times = now_times
                if busy is not None:
                    extras.append(f"load {busy:.0f}%")
                if extras:
                    line += " | " + " ".join(extras)
                print(line, flush=True)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass


def _set(args, key, value):
    # OSError is a transport-level failure (socket missing or refused), which
    # is exactly the "is the daemon running?" case, so it gets the hint; a
    # ProtocolError is the daemon answering "no", which the hint would only
    # obscure.  The old version sniffed the message text for "No such file"
    # and "errno", which broke the moment an error message changed wording.
    try:
        res = core.call({"cmd": "set", "key": key, "value": value},
                        timeout=args.timeout)
    except OSError as e:
        die(f"{e}\n{need_daemon_hint()}")
    except ProtocolError as e:
        die(str(e))
    if args.json:
        print(json.dumps(res, indent=2, sort_keys=True))
        return
    # The daemon read the setting back before and after, so this sentence
    # describes the hardware, not our intention.  A no-op says so rather
    # than pretending something happened.  The activity form is what a
    # person reads after pressing a button ("Set charge limit to 80%");
    # the raw `a -> b` diff stays in --json for scripts.
    activity = res.get("activity") or core.describe_activity(
        key, res.get("was"), res.get("now"))
    print(green("✓ ") + (activity if res.get("changed") else dim(activity)))


def cmd_mode(args):
    if args.value is None:
        st = status(args)
        cur = (st.get("shift") or {}).get("current")
        avail = (st.get("shift") or {}).get("available") or []
        # Honour --json here too: a read-only query is exactly what a script
        # wants, and silently returning human text for a machine flag is the
        # same bug as the one that dropped --json before the subcommand.
        if args.json:
            print(json.dumps({"current": cur, "available": avail},
                             indent=2))
            return
        print(cur or "?")
        print(dim("available: " + ", ".join(avail)))
        return
    _set(args, "shift", args.value)


