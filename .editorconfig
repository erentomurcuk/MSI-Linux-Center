# MSI Linux Control - editor configuration
# https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 79

# Python, plus the two extensionless programs - both are Python.
[*.py]
indent_size = 4

[src/msi-control]
indent_size = 4

[src/msi-control-gui]
indent_size = 4

[*.{sh,bash}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{md,json,desktop}]
indent_size = 2
trim_trailing_whitespace = false

[*.service]
indent_size = 4
